@model EcommerceSystem.Models.CartViewModel

<div class="wrap-header-cart js-panel-cart">
    <div class="s-full js-hide-cart"></div>
    <div class="header-cart flex-col-l p-l-65 p-r-25">
        <div class="header-cart-title flex-w flex-sb-m p-b-8">
            <span class="mtext-103" style="color: #fff;">Your Cart</span>
            <div class="fs-35 lh-10 p-lr-5 pointer hov-cl1 trans-04 js-hide-cart" style="color: #fff;">
                <i class="zmdi zmdi-close"></i>
            </div>
        </div>
        
        <div class="header-cart-content flex-w js-pscroll">
            <ul class="header-cart-wrapitem w-full">
                
                @if(!Model.Items.Any())
                {
                    <li class="p-b-10" style="color: #adb5bd;">Your cart is currently empty.</li>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <li class="header-cart-item flex-w flex-t m-b-12">
                            <div class="header-cart-item-img" style="width: 60px; height: 80px; overflow: hidden; background: #fff; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                <img src="@item.ImageUrl" alt="@item.ProductName" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                            </div>
                            <div class="header-cart-item-txt p-t-8" style="padding-left: 15px; width: calc(100% - 60px);">
                                <a href="#" class="header-cart-item-name m-b-18 hov-cl1 trans-04" style="color: #f8f9fa; display: block; text-decoration: none;">@item.ProductName</a>
                                <span class="header-cart-item-info" style="color: #adb5bd;">@item.Quantity x $@item.Price.ToString("0.00")</span>
                            </div>
                        </li>
                    }
                }
            </ul>
            
            <div class="w-full">
                <div class="header-cart-total w-full p-tb-40" style="color: #fff; font-size: 18px; border-top: 1px solid rgba(255,255,255,0.1);">
                    Total: $@Model.CartTotal.ToString("0.00")
                </div>
                <div class="header-cart-buttons flex-w w-full">
                    <a asp-controller="Customer" asp-action="Cart" class="flex-c-m stext-101 cl0 size-107 bg1 bor2 hov-btn1 p-lr-15 trans-04 m-r-8 m-b-10">View Cart</a>
                    <a asp-controller="Customer" asp-action="Checkout" class="flex-c-m stext-101 cl0 size-107 bg1 bor2 hov-btn1 p-lr-15 trans-04 m-b-10">Check Out</a>
                </div>
            </div>
        </div>
    </div>
</div>