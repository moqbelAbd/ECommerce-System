@{
    ViewData["Title"] = "About Us  ";
}

<!-- Title page -->
<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('@Url.Content("~/images/bg-01.jpg")');">
    <h2 class="ltext-105 cl0 txt-center" style="color: black;">
        About Rolexyal
    </h2>
</section>

<!-- Content page -->
<section class="bg0 p-t-75 p-b-120">
    <div class="container">
        <div class="row p-b-148">
            <div class="col-md-7 col-lg-8">
                <div class="p-t-7 p-r-85 p-r-15-lg p-r-0-md">
                    <h3 class="mtext-111 cl2 p-b-16">
                        Our Story & Passion for Time
                    </h3>

                    <p class="stext-113 cl6 p-b-26">
                        Founded with a deep appreciation for craftsmanship and precision, Rolexyal began as a dedicated vision to bring timeless elegance and modern sophistication to watch enthusiasts. We believe that a watch is much more than a tool to tell time; it is a statement of personal identity, a reflection of character, and a companion for life's most memorable milestones. From classic automatic movements to sleek minimalist designs, every piece in our collection is curated to embody perfection.
                    </p>

                    <p class="stext-113 cl6 p-b-26">
                        Over the years, Rolexyal has grown to become a trusted destination for luxury and casual timepieces, as well as premium accessories and straps. Our commitment goes beyond selling watches—we strive to deliver an exceptional shopping experience built on authenticity, superior quality, and unmatched customer care right here in the heart of Amman, Jordan.
                    </p>

                    <p class="stext-113 cl6 p-b-26">
                        Have a question or looking for a specific timepiece? Visit us in store or reach out to us at (+962) 6 500 0000.
                    </p>
                </div>
            </div>

            <div class="col-11 col-md-5 col-lg-4 m-lr-auto">
                <div class="how-bor1">
                    <div class="hov-img0">
                        <img src="~/images/about-01.jpg" alt="Luxury Watches">
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="order-md-2 col-md-7 col-lg-8 p-b-30">
                <div class="p-t-7 p-l-85 p-l-15-lg p-l-0-md">
                    <h3 class="mtext-111 cl2 p-b-16">
                        Our Mission & Craftsmanship
                    </h3>

                    <p class="stext-113 cl6 p-b-26">
                        Our mission at Rolexyal is simple: to connect discerning individuals with world-class timepieces that blend durability, accuracy, and breathtaking aesthetics. We partner with renowned designers and reliable manufacturers to ensure that every watch we offer meets the highest industry standards. Whether you are dressing up for a formal gala, heading to a business meeting, or looking for an everyday casual accessory, Rolexyal ensures you wear your time with absolute confidence and style.
                    </p>

                    <div class="bor16 p-l-29 p-b-9 m-t-22">
                        <p class="stext-114 cl6 p-r-40 p-b-11">
                            "Time is what we want most, but what we use worst. Invest in a timepiece that reminds you of the value of every single second."
                        </p>

                        <span class="stext-111 cl8">
                              Philosophy
                        </span>
                    </div>
                </div>
            </div>

            <div class="order-md-1 col-11 col-md-5 col-lg-4 m-lr-auto p-b-30">
                <div class="how-bor2">
                    <div class="hov-img0">
                        <img src="~/images/about-02.jpg" alt="Watch Craftsmanship">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>