@using EcommerceSystem.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context

@{
    var sidebarCategories = await _context.Categories
        .Where(c => !c.IsDeleted)
        .Include(c => c.SubCategories.Where(sc => !sc.IsDeleted))
        .OrderBy(c => c.CategoryName)
        .ToListAsync();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] - Rolexyal</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="icon" type="image/png" href="~/images/icons/favicon.png" />
    <link rel="stylesheet" type="text/css" href="~/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="~/fonts/iconic/css/material-design-iconic-font.min.css">
    <link rel="stylesheet" type="text/css" href="~/fonts/linearicons-v1.0.0/icon-font.min.css">
    <link rel="stylesheet" type="text/css" href="~/vendor/animate/animate.css">
    <link rel="stylesheet" type="text/css" href="~/vendor/css-hamburgers/hamburgers.min.css">
    <link rel="stylesheet" type="text/css" href="~/vendor/animsition/css/animsition.min.css">
    <link rel="stylesheet" type="text/css" href="~/vendor/select2/select2.min.css">
    <link rel="stylesheet" type="text/css" href="~/vendor/daterangepicker/daterangepicker.css">
    <link rel="stylesheet" type="text/css" href="~/vendor/slick/slick.css">
    <link rel="stylesheet" type="text/css" href="~/vendor/MagnificPopup/magnific-popup.css">
    <link rel="stylesheet" type="text/css" href="~/vendor/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" type="text/css" href="~/css/util.css">
    <link rel="stylesheet" type="text/css" href="~/css/main.css">
    <link rel="stylesheet" type="text/css" href="~/css/toast.css">

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body.animsition {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .page-content-wrapper {
            flex: 1 0 auto;
        }

        .menu-mobile {
            background-color: #1a1d20 !important;
            border-top: 1px solid rgba(201, 170, 111, 0.2);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

            .menu-mobile .main-menu-m {
                background-color: #1a1d20 !important;
                padding: 15px 0;
            }

                .menu-mobile .main-menu-m li {
                    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
                }

                    .menu-mobile .main-menu-m li a {
                        color: #f8f9fa !important;
                        padding: 14px 25px;
                        font-size: 15px;
                        font-family: 'Poppins-Medium', sans-serif;
                        letter-spacing: 0.5px;
                        transition: all 0.3s ease;
                        display: block;
                    }

                        .menu-mobile .main-menu-m li a:hover {
                            color: #c9aa6f !important;
                            background-color: rgba(201, 170, 111, 0.08);
                            padding-left: 30px;
                        }

        .header-cart {
            background-color: #1a1d20 !important;
            color: #fff !important;
        }

        .auth-btn-login {
            color: #c9aa6f !important;
            border: 1px solid #c9aa6f !important;
            background-color: transparent !important;
            border-radius: 20px !important;
            padding: 6px 18px !important;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .auth-btn-login:hover {
                background-color: #c9aa6f !important;
                color: #1a1d20 !important;
            }

        .auth-btn-register {
            color: #1a1d20 !important;
            background-color: #c9aa6f !important;
            border: 1px solid #c9aa6f !important;
            border-radius: 20px !important;
            padding: 6px 18px !important;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .auth-btn-register:hover {
                background-color: transparent !important;
                color: #c9aa6f !important;
                border-color: #c9aa6f !important;
            }

        .icon-header-item.cart-styled {
            color: #c9aa6f !important;
            transition: transform 0.3s ease;
        }

            .icon-header-item.cart-styled:hover {
                transform: scale(1.1);
            }

        .icon-header-noti::after {
            background-color: #c9aa6f !important;
            color: #1a1d20 !important;
            font-weight: 700;
        }

        footer.bg3 {
            padding-top: 5px !important;
            padding-bottom: 5px !important;
            flex-shrink: 0;
        }

            footer.bg3 .container {
                line-height: 1;
            }

            footer.bg3 img.logo-footer {
                max-height: 80px !important;
                width: auto;
            }
    </style>
</head>
<body class="animsition">

    <partial name="_ToastPartial" />

    <!-- Header -->
    <header class="header-v3">
        <div class="container-menu-desktop trans-03">
            <div class="wrap-menu-desktop">
                <nav class="limiter-menu-desktop p-l-45">

                    <div class="flex-c-m flex-w p-b-18">
                        <a asp-controller="Home" asp-action="Index" class="logo">
                            <img src="~/images/icons/logo-01.png" alt="IMG-LOGO" style="max-height: 120px; width: auto;">
                        </a>
                    </div>

                    <!-- Menu desktop -->
                    <div class="menu-desktop">
                        <ul class="main-menu">
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a asp-controller="Admin" asp-action="Index">Dashboard</a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                            }

                            <li>
                                <a asp-controller="Home" asp-action="Shop">Shop</a>
                            </li>

                            <li>
                                <a asp-controller="Home" asp-action="About">About</a>
                            </li>

                            <li>
                                <a asp-controller="Home" asp-action="Contact">Contact</a>
                            </li>
                        </ul>
                    </div>

                    <div class="wrap-icon-header flex-w flex-r-m h-full">
                        @if (!User.IsInRole("Admin") && (User.Identity?.IsAuthenticated ?? false))
                        {
                            <div class="flex-c-m h-full p-l-18 p-r-10">
                                <a asp-controller="Home" asp-action="Profile" class="icon-header-item cl2 hov-cl1 trans-04 p-lr-11" title="My Profile">
                                    <i class="zmdi zmdi-account" style="font-size: 22px; color: #c9aa6f;"></i>
                                </a>
                            </div>
                        }

                        @if (!User.IsInRole("Admin"))
                        {
                            <div class="flex-c-m h-full p-l-10 p-r-25 bor6">
                                <div class="icon-header-item cart-styled hov-cl1 trans-04 p-lr-11 icon-header-noti js-show-cart" data-notify="2">
                                    <i class="zmdi zmdi-shopping-cart"></i>
                                </div>
                            </div>
                        }

                        @if (!(User.Identity?.IsAuthenticated ?? false))
                        {
                            <div class="flex-c-m h-full p-l-18 p-r-25 bor6 gap-2" style="display: flex; align-items: center;">
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn auth-btn-login m-r-5">Login</a>
                                <a asp-area="Identity" asp-page="/Account/Register" class="btn auth-btn-register">Register</a>
                            </div>
                        }

                        <div class="flex-c-m h-full p-lr-19">
                            <div class="icon-header-item cl2 hov-cl1 trans-04 p-lr-11 js-show-sidebar">
                                <i class="zmdi zmdi-menu"></i>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </div>

        <!-- Header Mobile -->
        <div class="wrap-header-mobile">
            <div class="logo-mobile">
                <a asp-controller="Home" asp-action="Index"><img src="~/images/icons/logo-01.png" alt="IMG-LOGO" style="max-height: 80px; width: auto;"></a>
            </div>

            <div class="wrap-icon-header flex-w flex-r-m h-full m-r-15">
                @if (!User.IsInRole("Admin"))
                {
                    <div class="flex-c-m h-full p-r-5">
                        <div class="icon-header-item cart-styled hov-cl1 trans-04 p-lr-11 icon-header-noti js-show-cart" data-notify="2">
                            <i class="zmdi zmdi-shopping-cart"></i>
                        </div>
                    </div>
                }
            </div>

            <div class="btn-show-menu-mobile hamburger hamburger--squeeze">
                <span class="hamburger-box">
                    <span class="hamburger-inner" style="background-color: #fff;"></span>
                </span>
            </div>
        </div>

        <!-- Menu Mobile -->
        <div class="menu-mobile">
            <ul class="main-menu-m">
                @if (User.IsInRole("Admin"))
                {
                    <li><a href="@Url.Action("Index", "Admin")">Dashboard</a></li>
                    <li><a href="@Url.Action("Index", "Product")">Manage Products</a></li>
                }
                else
                {
                    <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                }
                <li><a href="@Url.Action("Shop", "Home")">Shop</a></li>
                <li><a href="@Url.Action("About", "Home")">About</a></li>
                <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                @if ((User.Identity?.IsAuthenticated ?? false))
                {
                    @if (User.IsInRole("Customer"))
                    {
                        <!-- تم التعديل هنا إلى Index -->
                        <li><a asp-controller="Wishlists" asp-action="Index" class="stext-102 trans-04">My Wishlist</a></li>
                    }
                    <li><a asp-controller="Home" asp-action="Profile">My Account</a></li>
                }
            </ul>
        </div>
    </header>

    <!-- Sidebar -->
    <aside class="wrap-sidebar js-sidebar">
        <div class="s-full js-hide-sidebar"></div>
        <div class="sidebar flex-col-l p-t-22 p-b-25" style="width: 300px; max-width: 80%; display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
            <div>
                <div class="w-full d-flex justify-content-end p-r-15 p-t-5">
                    <div class="fs-35 lh-10 pointer hov-cl1 trans-04 js-hide-sidebar p-2">
                        <i class="zmdi zmdi-close"></i>
                    </div>
                </div>

                <div class="sidebar-content flex-w w-full p-lr-35 js-pscroll" style="max-height: calc(100vh - 160px);">
                    <ul class="sidebar-link w-full">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="p-b-13">
                                <a asp-controller="Admin" asp-action="Index" class="stext-102 trans-04">Dashboard</a>
                            </li>
                            <li class="p-b-13">
                                <a asp-controller="Product" asp-action="Index" class="stext-102 trans-04 fw-bold" style="color: #c9aa6f;">Manage Products</a>
                            </li>
                        }
                        else
                        {
                            <li class="p-b-13">
                                <a asp-controller="Home" asp-action="Index" class="stext-102 trans-04">Home</a>
                            </li>
                        }

                        <li class="p-b-13">
                            <div class="d-flex justify-content-between align-items-center w-full">
                                <a asp-controller="Category" asp-action="Index" class="stext-102 trans-04 font-weight-bold" style="flex-grow: 1;">Categories</a>
                                <span data-toggle="collapse" data-target="#mainCategoriesCollapse" aria-expanded="false" style="cursor: pointer; padding: 5px 10px; display: inline-block;">
                                    <i class="fa fa-angle-down trans-04" style="font-size: 16px; font-weight: bold; color: #c9aa6f;"></i>
                                </span>
                            </div>

                            <div class="collapse list-unstyled ps-3 p-l-15 p-t-8" id="mainCategoriesCollapse">
                                @foreach (var cat in sidebarCategories)
                                {
                                    var collapseId = $"subCat_{cat.CategoryId}";
                                    <div class="p-b-8 d-flex justify-content-between align-items-center">
                                        <a asp-controller="Home" asp-action="Shop" asp-route-categoryId="@cat.CategoryId" class="stext-102 trans-04" style="color: #adb5bd; flex-grow: 1;">- @cat.CategoryName</a>
                                        @if (cat.SubCategories != null && cat.SubCategories.Any())
                                        {
                                            <span data-toggle="collapse" data-target="#@collapseId" aria-expanded="false" style="cursor: pointer; padding: 2px 8px;">
                                                <i class="fa fa-angle-down" style="font-size: 13px; color: #c9aa6f;"></i>
                                            </span>
                                        }
                                    </div>
                                    @if (cat.SubCategories != null && cat.SubCategories.Any())
                                    {
                                        <div class="collapse ps-3 p-l-15 p-b-5" id="@collapseId">
                                            @foreach (var sub in cat.SubCategories)
                                            {
                                                <a asp-controller="Home" asp-action="Shop" asp-route-categoryId="@cat.CategoryId" asp-route-subCategoryId="@sub.SubCategoryId" class="stext-102 trans-04 d-block p-b-4" style="color: #6c757d; font-size: 13px;">• @sub.SubCategoryName</a>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="p-b-13">
                                <a asp-controller="Admin" asp-action="Customers" class="stext-102 trans-04">Customers</a>
                            </li>
                            <li class="p-b-13">
                                <a asp-controller="Admin" asp-action="Orders" class="stext-102 trans-04">Orders</a>
                            </li>
                            <li class="p-b-13">
                                <a asp-controller="Admin" asp-action="Testimonials" class="stext-102 trans-04">Testimonials</a>
                            </li>
                        }
                        else if (User.IsInRole("Customer"))
                        {
                            <li class="p-b-13">
                                <a asp-controller="Customer" asp-action="OrderHistory" class="stext-102 trans-04">My Orders</a>
                            </li>
                            <li class="p-b-13">
                                <!-- تم التعديل هنا إلى Index -->
                                <a asp-controller="Wishlists" asp-action="Index" class="stext-102 trans-04">My Wishlist</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="w-full p-lr-35 p-b-20">
                <div class="d-flex align-items-center justify-content-between w-full">
                    <a asp-controller="Home" asp-action="Index" class="logo">
                        <img src="~/images/icons/logo-01.png" alt="IMG-LOGO" style="max-height: 70px; width: auto;">
                    </a>

                    @if ((User.Identity?.IsAuthenticated ?? false))
                    {
                        <form class="form-inline m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="btn btn-link text-danger p-0 font-weight-bold" style="text-decoration: none; font-size: 14px;" title="Logout">
                                <i class="fa fa-sign-out"></i> Logout
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </aside>

    <!-- Cart Sidebar -->
        <div id="cart-sidebar-container">
            @if (!User.IsInRole("Admin"))
            {
                @await Component.InvokeAsync("CartSidebar")
            }
        </div>

    <div class="page-content-wrapper">
        @RenderBody()
    </div>

    <footer class="bg3 p-t-5 p-b-5" style="background-color: #1a1d20 !important;">
        <div class="container">
            <div class="flex-w flex-sb-m">
                <div class="p-b-0">
                    <a asp-controller="Home" asp-action="Index" class="logo">
                        <img src="~/images/icons/logo-01.png" alt="IMG-LOGO" class="logo-footer" style="max-height: 70px; width: auto;">
                    </a>
                </div>
                <div class="p-b-0">
                    <p class="stext-107" style="color: #adb5bd; font-size: 12px;">
                        Copyright &copy; @DateTime.Now.Year All rights reserved
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <div class="btn-back-to-top" id="myBtn">
        <span class="symbol-btn-back-to-top"><i class="zmdi zmdi-chevron-up"></i></span>
    </div>

    <script src="~/vendor/jquery/jquery-3.2.1.min.js"></script>
    <script src="~/vendor/animsition/js/animsition.min.js"></script>
    <script src="~/vendor/bootstrap/js/popper.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/vendor/select2/select2.min.js"></script>
    <script>
        $(".js-select2").each(function() {
            $(this).select2({
                minimumResultsForSearch: 20,
                dropdownParent: $(this).next('.dropDownSelect2')
            });
        })
    </script>
    <script src="~/vendor/daterangepicker/moment.min.js"></script>
    <script src="~/vendor/daterangepicker/daterangepicker.js"></script>
    <script src="~/vendor/slick/slick.min.js"></script>
    <script src="~/js/slick-custom.js"></script>
    <script src="~/vendor/parallax100/parallax100.js"></script>
    <script>
        $('.parallax100').parallax100();
    </script>
    <script src="~/vendor/MagnificPopup/jquery.magnific-popup.min.js"></script>
    <script src="~/vendor/isotope/isotope.pkgd.min.js"></script>
    <script src="~/vendor/sweetalert/sweetalert.min.js"></script>
    <script src="~/vendor/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script>
        $('.js-pscroll').each(function() {
            $(this).css('position', 'relative');
            $(this).css('overflow', 'hidden');
            var ps = new PerfectScrollbar(this, {
                wheelSpeed: 1,
                scrollingThreshold: 1000,
                wheelPropagation: false,
            });
            $(window).on('resize', function() {
                ps.update();
            })
        });
    </script>
    <script src="~/js/main.js"></script>
    <script src="~/js/toast.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>