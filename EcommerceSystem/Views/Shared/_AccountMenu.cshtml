@inject IHttpContextAccessor HttpContextAccessor

@{
    var currentPath = Context.Request.Path.Value ?? "";

    // تعديل الشرط ليشمل مسار الـ Home أو الـ Customer حسب مكان صفحة البروفايل لديك
    bool isProfile = currentPath.Contains("/Home/Profile", StringComparison.OrdinalIgnoreCase) ||
                     currentPath.Contains("/Customer/Profile", StringComparison.OrdinalIgnoreCase) ||
                     currentPath.Contains("/Customer/CompleteProfile", StringComparison.OrdinalIgnoreCase);

    bool isCards = currentPath.Contains("/Customer/PaymentCards", StringComparison.OrdinalIgnoreCase);
    bool isOrders = currentPath.Contains("/Customer/OrderHistory", StringComparison.OrdinalIgnoreCase);
    bool isWishlist = currentPath.Contains("/Customer/Wishlist", StringComparison.OrdinalIgnoreCase);
}
<div style="background: #f8f9fa; padding: 25px; border-radius: 4px; border: 1px solid #eaeaea;">
    <h4 style="font-size: 18px; font-weight: 600; color: #111; margin-bottom: 20px;">
        Account Menu
    </h4>
    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
        <li>
            <a asp-controller="Home" asp-action="Profile" style="display: flex; align-items: center; padding: 12px 15px; border-radius: 4px; text-decoration: none; font-size: 15px; font-weight: 500; background-color: @(isProfile ? "#fff" : "transparent"); color: @(isProfile ? "#717fe0" : "#666"); box-shadow: @(isProfile ? "0 1px 3px rgba(0,0,0,0.05)" : "none"); border: @(isProfile ? "1px solid #eaeaea" : "none"); transition: all 0.3s;">
                <i class="fa fa-user-o m-r-12" style="font-size: 16px;"></i> Profile Information
            </a>
        </li>
        <li>
            <a asp-controller="Customer" asp-action="PaymentCards" style="display: flex; align-items: center; padding: 12px 15px; border-radius: 4px; text-decoration: none; font-size: 15px; font-weight: 500; background-color: @(isCards ? "#fff" : "transparent"); color: @(isCards ? "#717fe0" : "#666"); box-shadow: @(isCards ? "0 1px 3px rgba(0,0,0,0.05)" : "none"); border: @(isCards ? "1px solid #eaeaea" : "none"); transition: all 0.3s;">
                <i class="fa fa-credit-card m-r-12" style="font-size: 16px;"></i> My Cards
            </a>
        </li>
        <li>
            <a asp-controller="Customer" asp-action="OrderHistory" style="display: flex; align-items: center; padding: 12px 15px; border-radius: 4px; text-decoration: none; font-size: 15px; font-weight: 500; background-color: @(isOrders ? "#fff" : "transparent"); color: @(isOrders ? "#717fe0" : "#666"); box-shadow: @(isOrders ? "0 1px 3px rgba(0,0,0,0.05)" : "none"); border: @(isOrders ? "1px solid #eaeaea" : "none"); transition: all 0.3s;">
                <i class="fa fa-shopping-bag m-r-12" style="font-size: 16px;"></i> My Orders
            </a>
        </li>
        <li>
            <a asp-controller="Customer" asp-action="Wishlist" style="display: flex; align-items: center; padding: 12px 15px; border-radius: 4px; text-decoration: none; font-size: 15px; font-weight: 500; background-color: @(isWishlist ? "#fff" : "transparent"); color: @(isWishlist ? "#717fe0" : "#666"); box-shadow: @(isWishlist ? "0 1px 3px rgba(0,0,0,0.05)" : "none"); border: @(isWishlist ? "1px solid #eaeaea" : "none"); transition: all 0.3s;">
                <i class="fa fa-heart-o m-r-12" style="font-size: 16px;"></i> My Wishlist
            </a>
        </li>
    </ul>
</div>