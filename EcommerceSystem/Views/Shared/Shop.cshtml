@using EcommerceSystem.Models
@using EcommerceSystem.Models.ViewModels
@model IEnumerable<Product>

@{
    ViewData["Title"] = "Shop Products";

    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    Guid? selectedCategoryId = ViewBag.SelectedCategoryId;
    Guid? selectedSubCategoryId = ViewBag.SelectedSubCategoryId;
    string? searchTerm = ViewBag.SearchTerm;
    decimal? minPrice = ViewBag.MinPrice;
    decimal? maxPrice = ViewBag.MaxPrice;
    string? sort = ViewBag.Sort;
    int totalPages = ViewBag.TotalPages;
    int page = ViewBag.Page;
    int totalCount = ViewBag.TotalCount;

    string? selectedCategoryName = selectedCategoryId.HasValue
        ? categories.FirstOrDefault(c => c.CategoryId == selectedCategoryId.Value)?.CategoryName
        : null;

    string? selectedSubCategoryName = selectedSubCategoryId.HasValue
        ? categories.SelectMany(c => c.SubCategories).FirstOrDefault(sc => sc.SubCategoryId == selectedSubCategoryId.Value)?.SubCategoryName
        : null;

    var userWishlistIds = ViewBag.UserWishlistIds as List<Guid> ?? new List<Guid>();

    var pagination = new PaginationViewModel
    {
        CurrentPage = page,
        TotalPages = totalPages,
        PageParam = "page",
        Action = "Shop",
        Controller = "Home",
        RouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary
        {
            ["search"] = searchTerm,
            ["categoryId"] = selectedCategoryId,
            ["subCategoryId"] = selectedSubCategoryId,
            ["minPrice"] = minPrice,
            ["maxPrice"] = maxPrice
        }
    };

}

<!-- Title Banner -->
<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('/images/bg-01.jpg');">
    <h2 class="ltext-105 cl0 txt-center" style="font-weight: 600; letter-spacing: 3px; color: #222;">
        OUR COLLECTION
    </h2>
</section>

<div class="bg0 m-t-40 p-b-140">
    <div class="container">

        <!-- Category / SubCategory Nav -->
        <div class="shop-cat-nav p-b-25 mb-4 border-bottom">
            <ul class="shop-cat-nav-list">
                <li class="@(selectedCategoryId == null ? "active" : "")">
                    <a asp-controller="Home" asp-action="Shop">All Products</a>
                </li>

                @foreach (var category in categories)
                {
                    var subCategories = category.SubCategories?.Where(sc => !sc.IsDeleted).ToList() ?? new List<SubCategory>();

                    <li class="shop-cat-item @(selectedCategoryId == category.CategoryId ? "active" : "")">
                        <a asp-controller="Home" asp-action="Shop" asp-route-categoryId="@category.CategoryId">
                            @category.CategoryName
                        </a>

                        @if (subCategories.Any())
                        {
                            <ul class="shop-subcat-dropdown shadow-lg">
                                @foreach (var subCategory in subCategories)
                                {
                                    <li class="@(selectedSubCategoryId == subCategory.SubCategoryId ? "active" : "")">
                                        <a asp-controller="Home" asp-action="Shop"
                                           asp-route-categoryId="@category.CategoryId"
                                           asp-route-subCategoryId="@subCategory.SubCategoryId">
                                            <i class="fa fa-angle-right m-r-5 text-muted"></i> @subCategory.SubCategoryName
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </div>

        <!-- Controls & Active Filters Bar -->
        <div class="flex-w flex-sb-m p-b-35">

            <!-- Active filter summary -->
            <div class="stext-102 cl6 d-flex align-items-center flex-wrap gap-2">
                @if (selectedCategoryName != null || selectedSubCategoryName != null || !string.IsNullOrWhiteSpace(searchTerm))
                {
                    <span class="fw-semibold text-dark">Showing:</span>
                    @if (selectedCategoryName != null)
                    {
                        <span class="badge bg-dark text-warning px-3 py-2" style="border-radius: 20px;">@selectedCategoryName</span>
                    }
                    @if (selectedSubCategoryName != null)
                    {
                        <span class="badge bg-secondary text-white px-3 py-2" style="border-radius: 20px;">@selectedSubCategoryName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <span class="badge bg-light text-dark border px-3 py-2" style="border-radius: 20px;">"@searchTerm"</span>
                    }
                }
                else
                {
                    <span class="text-muted" style="font-size: 14px;">Showing all exquisite products</span>
                }
            </div>

            <!-- Filter & Search Trigger Buttons -->
            <div class="flex-w flex-c-m m-tb-10 gap-2">
                <div class="flex-c-m stext-106 cl6 size-104 bor4 pointer hov-btn3 trans-04 m-tb-4 js-show-filter px-4" style="border-radius: 25px;">
                    <i class="icon-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-filter-list"></i>
                    <i class="icon-close-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
                    Filter
                </div>

                <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 js-show-search px-4" style="border-radius: 25px;">
                    <i class="icon-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-search"></i>
                    <i class="icon-close-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
                    Search
                </div>
            </div>

            <!-- Search product Panel -->
            <div class="dis-none panel-search w-full p-t-15 p-b-15">
                <form asp-controller="Home" asp-action="Shop" method="get" class="bor8 dis-flex p-l-15 bg-light" style="border-radius: 30px; overflow: hidden;">
                    <input type="hidden" name="categoryId" value="@selectedCategoryId" />
                    <input type="hidden" name="subCategoryId" value="@selectedSubCategoryId" />

                    <button type="submit" class="size-113 flex-c-m fs-16 cl2 hov-cl1 trans-04 border-0 bg-transparent">
                        <i class="zmdi zmdi-search"></i>
                    </button>

                    <input class="mtext-107 cl2 size-114 plh2 p-r-15 border-0 bg-transparent" type="text" name="searchTerm" value="@searchTerm" placeholder="Search luxury items...">
                </form>
            </div>

            <!-- Filter Panel -->
            <div class="dis-none panel-filter w-full p-t-15">
                <form asp-controller="Home" asp-action="Shop" method="get" class="wrap-filter flex-w bg-light w-full p-lr-40 p-t-30 p-b-30 p-lr-15-sm shadow-sm" style="border-radius: 16px; border: 1px solid #eaeaea;">
                    <input type="hidden" name="categoryId" value="@selectedCategoryId" />
                    <input type="hidden" name="subCategoryId" value="@selectedSubCategoryId" />
                    <input type="hidden" name="searchTerm" value="@searchTerm" />

                    <div class="filter-col1 p-r-40 p-b-15">
                        <div class="mtext-102 cl2 p-b-10 fw-bold">
                            Sort By
                        </div>
                        <select name="sort" class="form-select bg-white shadow-none" style="min-width: 220px; border-radius: 8px; padding: 10px;">
                            <option value="" selected="@(string.IsNullOrEmpty(sort))">Name: A to Z</option>
                            <option value="name_desc" selected="@(sort == "name_desc")">Name: Z to A</option>
                            <option value="price_asc" selected="@(sort == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(sort == "price_desc")">Price: High to Low</option>
                        </select>
                    </div>

                    <div class="filter-col2 p-r-40 p-b-15">
                        <div class="mtext-102 cl2 p-b-10 fw-bold">
                            Price Range ($)
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input type="number" min="0" step="0.01" name="minPrice" value="@minPrice" class="form-control bg-white shadow-none" placeholder="Min" style="width: 120px; border-radius: 8px;" />
                            <span class="text-muted fw-bold">&ndash;</span>
                            <input type="number" min="0" step="0.01" name="maxPrice" value="@maxPrice" class="form-control bg-white shadow-none" placeholder="Max" style="width: 120px; border-radius: 8px;" />
                        </div>
                    </div>

                    <div class="filter-col3 p-b-15 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-dark px-4 py-2" style="border-radius: 20px; font-weight: 500; background-color: #1a1d20;">
                            <i class="fa fa-filter m-r-5"></i> Apply Filter
                        </button>

                        <a asp-controller="Home" asp-action="Shop"
                           asp-route-categoryId="@selectedCategoryId"
                           asp-route-subCategoryId="@selectedSubCategoryId"
                           class="btn btn-outline-secondary px-4 py-2" style="border-radius: 20px; font-weight: 500;">
                            Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="card table-responsive"
             style="
            border:none;
            border-radius:10px;
            overflow:hidden;
            box-shadow:0 5px 25px rgba(0,0,0,0.08);
            ">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="alert alert-light border shadow-sm d-inline-block px-5 py-4" style="border-radius: 16px;">
                    <i class="fa fa-box-open fa-2x text-muted mb-2"></i>
                    <h5 class="text-dark fw-bold mb-1">No products found</h5>
                    <p class="text-muted mb-0" style="font-size: 13px;">Try checking your filters or search terms.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row isotope-grid">
                @foreach (var product in Model)
                {
                    var imagePath = product.ProductImages
                        .FirstOrDefault()
                        ?.ProductImagePath
                        ?? "~/images/product-01.jpg";

                    var cardData = new
                    {
                        ProductId = product.ProductId,
                        IsInWishlist = userWishlistIds.Contains(product.ProductId),
                        ImageUrl = Url.Content(imagePath),
                        Title = product.ProductName,
                        Subtitle = product.ProductPrice.ToString("C"),
                        DetailsUrl = Url.Action("Details", "Product", new { id = product.ProductId }),
                        ButtonText = "Quick View",
                        ShowAdminActions = User.IsInRole("Admin"),
                        EditUrl = Url.Action("Edit", "Product", new { id = product.ProductId }),
                        DeleteUrl = Url.Action("Delete", "Product", new { id = product.ProductId })
                    };

                    <partial name="_ProductCardPartial" model="cardData" />
                }
            </div>
                <div class="p-t-40 p-b-20 d-flex justify-content-center">
                    <partial name="_PaginationPartial" model="pagination" />
                </div>
        }
    </div>
</div>

<style>
    .js-show-filter:hover,
    .js-show-search:hover,
    .js-show-filter.show-filter,
    .js-show-search.show-search {
        border-color: #c9aa6f !important;
        background-color: #c9aa6f !important;
        color: #1a1d20 !important;
    }

        .js-show-filter:hover i,
        .js-show-search:hover i,
        .js-show-filter.show-filter i,
        .js-show-search.show-search i {
            color: #1a1d20 !important;
        }

    .shop-cat-nav-list {
        display: flex;
        flex-wrap: wrap;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 25px;
    }

        .shop-cat-nav-list > li {
            position: relative;
        }

            .shop-cat-nav-list > li > a {
                display: inline-block;
                padding: 8px 0;
                font-size: 15px;
                font-weight: 500;
                color: #555;
                text-decoration: none;
                border-bottom: 2px solid transparent;
                transition: all 0.3s ease;
            }

            .shop-cat-nav-list > li:hover > a,
            .shop-cat-nav-list > li.active > a {
                color: #c9aa6f;
                border-bottom-color: #c9aa6f;
            }

    .shop-subcat-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 220px;
        background: #fff;
        border: 1px solid #eaeaea;
        border-radius: 12px;
        list-style: none;
        margin: 5px 0 0 0;
        padding: 10px 0;
        z-index: 100;
    }

    .shop-cat-item:hover .shop-subcat-dropdown {
        display: block;
        animation: fadeIn 0.2s ease-in-out;
    }

    .shop-subcat-dropdown li a {
        display: block;
        padding: 8px 20px;
        font-size: 14px;
        color: #666;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .shop-subcat-dropdown li a:hover,
        .shop-subcat-dropdown li.active a {
            background: rgba(201, 170, 111, 0.08);
            color: #c9aa6f;
            padding-left: 24px;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .block2-pic:hover .block2-btn {
        opacity: 1 !important;
        visibility: visible !important;
        bottom: 25px !important;
    }
</style>