@using EcommerceSystem.Models
@model IEnumerable<Product>

@{
    ViewData["Title"] = "Shop Products";

    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    Guid? selectedCategoryId = ViewBag.SelectedCategoryId;
    Guid? selectedSubCategoryId = ViewBag.SelectedSubCategoryId;
    string? searchTerm = ViewBag.SearchTerm;
    decimal? minPrice = ViewBag.MinPrice;
    decimal? maxPrice = ViewBag.MaxPrice;
    string? sort = ViewBag.Sort;

    string? selectedCategoryName = selectedCategoryId.HasValue
        ? categories.FirstOrDefault(c => c.CategoryId == selectedCategoryId.Value)?.CategoryName
        : null;

    string? selectedSubCategoryName = selectedSubCategoryId.HasValue
        ? categories.SelectMany(c => c.SubCategories).FirstOrDefault(sc => sc.SubCategoryId == selectedSubCategoryId.Value)?.SubCategoryName
        : null;
    // جلب معرفات المنتجات المفضلة للعميل الحالي لتمييز الأيقونة
    var userWishlistIds = ViewBag.UserWishlistIds as List<Guid> ?? new List<Guid>();

}

<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('/images/bg-01.jpg');">
    <h2 class="ltext-105 cl0 txt-center" style="font-weight: 600; letter-spacing: 2px; color: #222;">
        OUR SHOP
    </h2>
</section>

<div class="bg0 m-t-60 p-b-140">
    <div class="container">

        <!-- Category / SubCategory Nav (hover to reveal subcategories) -->
        <div class="shop-cat-nav p-b-30">
            <ul class="shop-cat-nav-list">
                <li class="@(selectedCategoryId == null ? "active" : "")">
                    <a asp-controller="Home" asp-action="Shop">All Products</a>
                </li>

                @foreach (var category in categories)
                {
                    var subCategories = category.SubCategories?.Where(sc => !sc.IsDeleted).ToList() ?? new List<SubCategory>();

                    <li class="shop-cat-item @(selectedCategoryId == category.CategoryId ? "active" : "")">
                        <a asp-controller="Home" asp-action="Shop" asp-route-categoryId="@category.CategoryId">
                            @category.CategoryName
                        </a>

                        @if (subCategories.Any())
                        {
                            <ul class="shop-subcat-dropdown">
                                @foreach (var subCategory in subCategories)
                                {
                                    <li class="@(selectedSubCategoryId == subCategory.SubCategoryId ? "active" : "")">
                                        <a asp-controller="Home" asp-action="Shop"
                                           asp-route-categoryId="@category.CategoryId"
                                           asp-route-subCategoryId="@subCategory.SubCategoryId">
                                            @subCategory.SubCategoryName
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </div>

        <div class="flex-w flex-sb-m p-b-30">

            <!-- Active filter summary -->
            <div class="stext-102 cl6">
                @if (selectedCategoryName != null || selectedSubCategoryName != null || !string.IsNullOrWhiteSpace(searchTerm))
                {
                    <span>Showing:</span>
                    @if (selectedCategoryName != null)
                    {
                        <span class="badge bg-secondary m-l-8">@selectedCategoryName</span>
                    }
                    @if (selectedSubCategoryName != null)
                    {
                        <span class="badge bg-secondary m-l-8">@selectedSubCategoryName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <span class="badge bg-secondary m-l-8">"@searchTerm"</span>
                    }
                }
                else
                {
                    <span>Showing all products</span>
                }
            </div>

            <div class="flex-w flex-c-m m-tb-10">
                <div class="flex-c-m stext-106 cl6 size-104 bor4 pointer hov-btn3 trans-04 m-r-8 m-tb-4 js-show-filter">
                    <i class="icon-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-filter-list"></i>
                    <i class="icon-close-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
                    Filter
                </div>

                <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 js-show-search">
                    <i class="icon-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-search"></i>
                    <i class="icon-close-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
                    Search
                </div>
            </div>

            <!-- Search product -->
            <div class="dis-none panel-search w-full p-t-10 p-b-15">
                <form asp-controller="Home" asp-action="Shop" method="get" class="bor8 dis-flex p-l-15">
                    <input type="hidden" name="categoryId" value="@selectedCategoryId" />
                    <input type="hidden" name="subCategoryId" value="@selectedSubCategoryId" />

                    <button type="submit" class="size-113 flex-c-m fs-16 cl2 hov-cl1 trans-04">
                        <i class="zmdi zmdi-search"></i>
                    </button>

                    <input class="mtext-107 cl2 size-114 plh2 p-r-15" type="text" name="searchTerm" value="@searchTerm" placeholder="Search products...">
                </form>
            </div>

            <!-- Filter Panel -->
            <div class="dis-none panel-filter w-full p-t-10">
                <form asp-controller="Home" asp-action="Shop" method="get" class="wrap-filter flex-w bg6 w-full p-lr-40 p-t-27 p-b-27 p-lr-15-sm">
                    <input type="hidden" name="categoryId" value="@selectedCategoryId" />
                    <input type="hidden" name="subCategoryId" value="@selectedSubCategoryId" />
                    <input type="hidden" name="searchTerm" value="@searchTerm" />

                    <div class="filter-col1 p-r-40 p-b-15">
                        <div class="mtext-102 cl2 p-b-15">
                            Sort By
                        </div>

                        <select name="sort" class="form-control" style="min-width: 200px;">
                            <option value="" selected="@(string.IsNullOrEmpty(sort))">Name: A to Z</option>
                            <option value="name_desc" selected="@(sort == "name_desc")">Name: Z to A</option>
                            <option value="price_asc" selected="@(sort == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(sort == "price_desc")">Price: High to Low</option>
                        </select>
                    </div>

                    <div class="filter-col2 p-r-40 p-b-15">
                        <div class="mtext-102 cl2 p-b-15">
                            Price
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <input type="number" min="0" step="0.01" name="minPrice" value="@minPrice" class="form-control" placeholder="Min" style="width: 110px;" />
                            <span>&ndash;</span>
                            <input type="number" min="0" step="0.01" name="maxPrice" value="@maxPrice" class="form-control" placeholder="Max" style="width: 110px;" />
                        </div>
                    </div>

                    <div class="filter-col3 p-b-15 d-flex align-items-end gap-2">
                        <button type="submit" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-20 trans-04">
                            <i class="fa fa-filter m-r-8"></i>
                            Apply
                        </button>

                        <a asp-controller="Home" asp-action="Shop"
                           asp-route-categoryId="@selectedCategoryId"
                           asp-route-subCategoryId="@selectedSubCategoryId"
                           class="flex-c-m stext-101 cl2 size-101 bg3 bor1 hov-btn1 p-lr-20">
                            Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Products Grid (Using _ProductCardPartial) -->
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="alert alert-info d-inline-block px-5 py-3">
                    No products found.
                </div>
            </div>
        }
        else
        {
            <div class="row isotope-grid">
                @foreach (var product in Model)
                {
                    var imagePath = product.ProductImages
                        .FirstOrDefault()
                        ?.ProductImagePath
                        ?? "~/images/product-01.jpg";

                    var cardData = new
{
    ProductId = product.ProductId,                          // <--- مهم جداً للـ AJAX
    IsInWishlist = userWishlistIds.Contains(product.ProductId), // <--- لتلوين القلب إذا كان مضافاً
    ImageUrl = Url.Content(imagePath),
    Title = product.ProductName,
    Subtitle = product.ProductPrice.ToString("C"),
    DetailsUrl = Url.Action("Details", "Customer", new { id = product.ProductId }),
    ButtonText = "Quick View",
    ShowAdminActions = User.IsInRole("Admin"),
    EditUrl = Url.Action("Edit", "Product", new { id = product.ProductId }),
    DeleteUrl = Url.Action("Delete", "Product", new { id = product.ProductId })
};

                    <partial name="_ProductCardPartial" model="cardData" />
                }
            </div>
        }
    </div>
</div>

<style>
    .shop-cat-nav-list {
        display: flex;
        flex-wrap: wrap;
        list-style: none;
        margin: 0;
        padding: 0;
        border-bottom: 1px solid #eee;
    }

    .shop-cat-nav-list > li {
        position: relative;
        margin-right: 30px;
    }

    .shop-cat-nav-list > li > a {
        display: inline-block;
        padding: 12px 0;
        font-size: 15px;
        color: #333;
        text-decoration: none;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
    }

    .shop-cat-nav-list > li:hover > a,
    .shop-cat-nav-list > li.active > a {
        color: #c4a76b;
        border-bottom-color: #c4a76b;
    }

    .shop-subcat-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 200px;
        background: #fff;
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        border-radius: 6px;
        list-style: none;
        margin: 0;
        padding: 8px 0;
        z-index: 50;
    }

    .shop-cat-item:hover .shop-subcat-dropdown {
        display: block;
    }

    .shop-subcat-dropdown li a {
        display: block;
        padding: 8px 18px;
        font-size: 14px;
        color: #555;
        text-decoration: none;
        white-space: nowrap;
    }

    .shop-subcat-dropdown li a:hover,
    .shop-subcat-dropdown li.active a {
        background: #f8f5ee;
        color: #c4a76b;
    }

    .block2-pic:hover .block2-btn {
        opacity: 1 !important;
        visibility: visible !important;
        bottom: 25px !important;
    }
</style>
