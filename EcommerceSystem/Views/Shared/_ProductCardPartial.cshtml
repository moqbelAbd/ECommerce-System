@model dynamic
<div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item">
    <div class="block2" style="display: flex; flex-direction: column; height: 100%; border: 1px solid #eee; border-radius: 12px; overflow: hidden; background: #fff; transition: all 0.3s ease;">

        <!-- Image & Hover Button -->
        <div class="block2-pic hov-img0" style="width: 100%; height: 260px; display: flex; align-items: center; justify-content: center; background-color: #fcfcfc; position: relative; overflow: hidden;">
            <img src="@Model.ImageUrl" alt="@Model.Title" style="max-width: 90%; max-height: 90%; object-fit: contain; transition: transform 0.5s ease;">

            <a href="@Model.DetailsUrl" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04" style="position: absolute; bottom: 20px; opacity: 0; visibility: hidden; transition: all 0.3s ease; text-decoration: none;">
                @Model.ButtonText
            </a>
        </div>

        <!-- Info, Wishlist & Add to Cart -->
        <div class="block2-txt flex-w flex-t p-t-16 p-b-20 p-lr-20" style="display: flex; justify-content: space-between; align-items: flex-start; flex-grow: 1;">
            <div class="block2-txt-child1 flex-col-l" style="width: calc(100% - 45px);">
                <a href="@Model.DetailsUrl" class="stext-104 cl4 hov-cl1 trans-04 p-b-6" style="font-weight: 500; min-height: 44px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-decoration: none; color: #111;">
                    @Model.Title
                </a>
                <span class="stext-105 cl3" style="font-weight: 600; color: #111; font-size: 14px;">
                    @Model.Subtitle
                </span>
            </div>

            <!-- الجانب الأيمن: المفضلة وزر السلة الذهبي -->
            <div class="block2-txt-child2 flex-r" style="padding-top: 5px; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                
                <!-- Wishlist Icon for Customer Only -->
                @if (User.IsInRole("Customer"))
                {
                    bool isInWishlist = Model.IsInWishlist ?? false;

                    <button type="button" class="btn-toggle-wishlist p-0 border-0 bg-transparent" data-product-id="@Model.ProductId" style="cursor: pointer;" title="Add/Remove Wishlist">
                        <div class="btn-addwish-b2 dis-block pos-relative">
                            <!-- القلب الفاتح (غير مضاف) -->
                            <img class="icon-heart1 dis-block trans-04" src="~/images/icons/icon-heart-01.png" alt="ICON" style="@(isInWishlist ? "opacity: 0;" : "opacity: 1;")">
                            <!-- القلب الغامق (مضاف) -->
                            <img class="icon-heart2 dis-block trans-04 ab-t-l" src="~/images/icons/icon-heart-02.png" alt="ICON" style="@(isInWishlist ? "opacity: 1;" : "opacity: 0;")">
                        </div>
                    </button>
                }

                <!-- Add to Cart Button -->
                @if (!User.IsInRole("Admin"))
                {
                    <a href="javascript:void(0)" class="cart-gold-btn ajax-cart-btn" data-product-id="@Model.ProductId" title="Add to Cart">
                        <i class="fa fa-shopping-cart" style="font-size: 13px; color: #fff;"></i>
                    </a>
                }
            </div>
        </div>

        <!-- Admin Actions -->
        @if (Model.ShowAdminActions)
        {
            <div class="px-3 pb-3 pt-0 d-flex justify-content-end align-items-center gap-3 border-top bg-white mt-auto">
                <a href="@Model.EditUrl" class="btn btn-outline-warning btn-sm mt-2 px-3" title="Edit" style="border-radius: 20px; display: flex; align-items: center; justify-content: center; gap: 5px;">
                    <i class="fa fa-pencil" style="font-size: 11px;"></i> Edit
                </a>
                <a href="@Model.DeleteUrl" class="btn btn-outline-danger btn-sm mt-2 px-3" title="Delete" style="border-radius: 20px; display: flex; align-items: center; justify-content: center; gap: 5px;">
                    <i class="fa fa-trash" style="font-size: 11px;"></i> Delete
                </a>
            </div>
        }
    </div>
</div>

<style>
    .block2-pic:hover .block2-btn {
        opacity: 1 !important;
        visibility: visible !important;
        bottom: 25px !important;
    }

    .block2:hover {
        box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        transform: translateY(-3px);
    }

    .cart-gold-btn {
        background-color: #c5a059 !important;
        border: none !important;
        border-radius: 50% !important;
        width: 35px !important;
        height: 35px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        text-decoration: none !important;
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
        transition: all 0.3s ease;
    }

    .cart-gold-btn:hover {
        background-color: #b08d4c !important;
        transform: scale(1.08);
    }
</style>

<!-- سكريبت الـ AJAX مضمن هنا ليعمل تلقائياً مع أي كرت يتم عرضه في أي صفحة -->
<script>
    if (typeof wishlistScriptInitialized === 'undefined') {
        var wishlistScriptInitialized = true;
        document.addEventListener("DOMContentLoaded", function () {
            document.body.addEventListener("click", function (e) {
                const btn = e.target.closest(".btn-toggle-wishlist");
                if (!btn) return;
                
                e.preventDefault();
                const productId = btn.getAttribute("data-product-id");
                const heart1 = btn.querySelector(".icon-heart1");
                const heart2 = btn.querySelector(".icon-heart2");

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                fetch('/Wishlists/ToggleWishlist', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token || ''
                    },
                    body: `productId=${productId}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        if (data.isAdded) {
                            heart1.style.opacity = "0";
                            heart2.style.opacity = "1";
                        } else {
                            heart1.style.opacity = "1";
                            heart2.style.opacity = "0";
                        }
                    } else if (data.redirect) {
                        window.location.href = data.redirect;
                    }
                })
                .catch(error => console.error('Error:', error));
            });
        });
    }
</script>