@using EcommerceSystem.Models.ViewModels
@model IEnumerable<EcommerceSystem.Models.SubCategory>

@{
    ViewData["Title"] = "SubCategories";
    string search = ViewBag.Search;
    int totalPages = ViewBag.TotalPages;
    int page = ViewBag.Page;
    int totalCount = ViewBag.TotalCount ;

    var pagination = new PaginationViewModel
    {
        CurrentPage = page,
        TotalPages = totalPages,
        PageParam = "page",
        Action = "Index",
        Controller = "SubCategory",
        RouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary
        {
            ["search"] = search
        }
    };
}


<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 py-4">
        <div>
            <h2 style="color:#1a1d20; font-weight:600; margin-bottom:5px;">
                SubCategories
            </h2>
            <p style="color:#888; margin:0;">
                Manage your product subcategories
            </p>
        </div>

        <a asp-action="Create"
           class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
            <i class="fa fa-plus m-r-8"></i>
            Add SubCategory
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button"
                    class="close"
                    data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            @TempData["Warning"]
            <button type="button"
                    class="close"
                    data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    <div class="bor10 p-all-20 m-b-40">
        <form asp-controller="SubCategory" asp-action="Index" method="get" >

            <div class="row">

                <div class="col-md-8 m-b-15 flex-col ">

                    <label class="stext-102 cl3">
                        Search
                    </label>

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Search by SubCategory or Category name" />

                </div>

                <div class="col-md-4 d-flex align-items-end m-b-15">

                    <button type="submit"
                            class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-20 m-r-10 trans-04">

                        <i class="fa fa-search m-r-8"></i>

                        Search

                    </button>
                </div>
            </div>

        </form>
    </div>

    <!-- Table Card -->
    <div class="card"
         style="
            border:none;
            border-radius:10px;
            overflow:hidden;
            box-shadow:0 5px 25px rgba(0,0,0,0.08);
         ">
        @if (!Model.Any())
        {
            <div class="bor10 p-all-40 text-center">

                <i class="fa fa-users fa-2x m-b-15"></i>

                <h4 class="mtext-102 cl2">
                    No SubCategories yet
                </h4>

            </div>
        }

        else
        {
            <div class="table-responsive">

                <table class="table mb-0">

                    <thead style="background:#1a1d20; color:white;">
                        <tr>
                            <th style="padding:18px;">Image</th>
                            <th style="padding:18px;">SubCategory</th>
                            <th style="padding:18px;">Category</th>
                            <th style="padding:18px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                            @foreach (var item in Model)
                            {
                                <tr style="vertical-align:middle;">

                                    <!-- Image -->
                                    <td style="padding:15px;">
                                        <div style="
                                        width:70px;
                                        height:70px;
                                        border-radius:8px;
                                        background:#f8f8f8;
                                        display:flex;
                                        align-items:center;
                                        justify-content:center;
                                        overflow:hidden;
                                        ">
                                            <img src="@item.SubCategoryImagePath"
                                            alt="@item.SubCategoryName"
                                            style="
                                                max-width:100%;
                                                max-height:100%;
                                                object-fit:contain;
                                            " />
                                        </div>
                                    </td>

                                    <!-- Name -->
                                    <td style="padding:15px;">
                                        <strong style="color:#1a1d20;">
                                            @item.SubCategoryName
                                        </strong>
                                    </td>

                                    <!-- Category -->
                                    <td style="padding:15px;">
                                        <span style="
                                        color:#c9aa6f;
                                        font-weight:600;
                                        ">
                                            @(item.Category?.CategoryName ?? "N/A")
                                        </span>
                                    </td>

                                    <!-- Actions -->
                                    <td style="padding:15px;">

                                        <a asp-action="Details"
                                        asp-route-id="@item.SubCategoryId"
                                        class="btn btn-sm mr-1"
                                        style="
                                            border:1px solid #c9aa6f;
                                            color:#c9aa6f;
                                            border-radius:20px;
                                        ">
                                            <i class="fa fa-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                        asp-route-id="@item.SubCategoryId"
                                        class="btn btn-sm mr-1"
                                        style="
                                            border:1px solid #1a1d20;
                                            color:#1a1d20;
                                            border-radius:20px;
                                        ">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    @if (!item.IsDeleted)
                                    {
                                        <a asp-action="Delete"
                                        asp-route-id="@item.SubCategoryId"
                                        class="btn btn-sm"
                                        style="
                                            border:1px solid #dc3545;
                                            color:#dc3545;
                                            border-radius:20px;
                                        ">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="UnDelete"
                                           asp-route-id="@item.SubCategoryId"
                                           class="btn btn-sm bg-success"
                                           style=" border-radius:20px;
                                            ">
                                            <i class="fa fa-undo" style="color:white;"></i>
                                        </a>
                                    }
                                </td>

                                </tr>
                        }

                    </tbody>

                </table>

            </div>

               @await Html.PartialAsync("_PaginationPartial", pagination)

        }
    </div>

</div>