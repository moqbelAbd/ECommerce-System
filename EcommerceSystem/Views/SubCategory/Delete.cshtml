@model EcommerceSystem.Models.SubCategory

@{
    ViewData["Title"] = "Delete SubCategory";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card"
                 style="
                    border:none;
                    border-radius:12px;
                    box-shadow:0 5px 25px rgba(0,0,0,0.08);
                 ">

                <div class="card-body text-center p-5">
                    @if (!Model.IsDeleted)
                    {
                    <!-- Warning Icon -->
                    <div style="
                        width:70px;
                        height:70px;
                        border-radius:50%;
                        background:rgba(220,53,69,0.1);
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        margin:0 auto 25px;
                    ">

                        <i class="fa fa-trash"
                           style="
                                font-size:28px;
                                color:#dc3545;
                           ">
                        </i>

                    </div>

                    <h2 style="
                        color:#1a1d20;
                        margin-bottom:10px;
                    ">
                        Delete SubCategory?
                    </h2>

                        <p style="color:#888;">
                            Are you sure you want to delete this subcategory?
                        </p>
                    }
                    else
                    {
                        <div class="bg-success"
                            style="
                            width:70px;
                            height:70px;
                            border-radius:50%;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            margin:0 auto 25px;
                            ">

                            <i class="fa fa-undo "
                               style="
                                font-size:28px; color:white;">
                            </i>

                        </div>

                        <h2 style="
                            color:#1a1d20;
                            margin-bottom:10px;
                            ">
                            Restore SubCategory?
                        </h2>
                        <p style="color:#888;">
                            Are you sure you want to restore this subcategory?
                        </p>
                    }
                    <!-- SubCategory Preview -->
                    <div class="my-4"
                         style="
                            background:#f8f8f8;
                            border-radius:8px;
                            padding:20px;
                         ">

                        <img src="@Model.SubCategoryImagePath"
                             alt="@Model.SubCategoryName"
                             style="
                                max-width:120px;
                                max-height:120px;
                                object-fit:contain;
                                margin-bottom:15px;
                             " />

                        <h5 style="color:#1a1d20;">
                            @Model.SubCategoryName
                        </h5>

                        <p style="
                            color:#c9aa6f;
                            margin-bottom:0;
                            font-weight:600;
                        ">
                            @(Model.Category?.CategoryName ?? "N/A")
                        </p>

                    </div>

                    @if (!Model.IsDeleted)
                    {
                        <div class="alert alert-warning"
                             style="font-size:14px;">
                            This action will hide the subcategory from the store.
                        </div>

                        <!-- Delete Form -->
                        <form asp-action="Delete"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   asp-for="SubCategoryId" />

                            <div class="d-flex justify-content-center mt-4">

                                <a asp-action="Index"
                                   class="btn mr-2"
                                   style="
                                    border:1px solid #1a1d20;
                                    color:#1a1d20;
                                    border-radius:25px;
                                    padding:10px 25px;
                                    ">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn"
                                        style="
                                    background:#dc3545;
                                    color:white;
                                    border-radius:25px;
                                    padding:10px 25px;
                                    border:none;
                                    ">
                                    <i class="fa fa-trash mr-2"></i>
                                    Delete
                                </button>

                            </div>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-success" style="font-size:14px;">
                            This action will restore the subcategory to the store.
                        </div>

                        <!-- UnDelete Form -->
                        <form asp-action="UnDelete"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   asp-for="SubCategoryId" />

                            <div class="d-flex justify-content-center mt-4">

                                <a asp-action="Index"
                                   class="btn mr-2"
                                   style="
                                    border:1px solid #1a1d20;
                                    color:#1a1d20;
                                    border-radius:25px;
                                    padding:10px 25px;
                                    ">
                                    Cancel
                                </a>

                                <button type="submit" class="btn btn-success px-5 py-2" style="border-radius: 20px; font-weight: 500; padding:10px 25px; border:none;">
                                    <i class="fa fa-undo m-r-5"></i> Restore
                                </button>

                            </div>

                        </form>
                    }



                </div>

            </div>

        </div>

    </div>

</div>