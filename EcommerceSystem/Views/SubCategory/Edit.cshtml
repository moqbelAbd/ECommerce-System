@model EcommerceSystem.Models.SubCategory

@{
    ViewData["Title"] = "Edit SubCategory";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="mb-4">
                <h2 style="color:#1a1d20; font-weight:600;">
                    Edit SubCategory
                </h2>

                <p style="color:#888;">
                    Update subcategory information
                </p>
            </div>

            <div class="card"
                 style="
                    border:none;
                    border-radius:12px;
                    box-shadow:0 5px 25px rgba(0,0,0,0.08);
                 ">

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="SubCategoryId" />

                        <input type="hidden"
                               asp-for="SubCategoryImagePath" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Name -->
                        <div class="form-group mb-4">

                            <label asp-for="SubCategoryName"
                                   style="
                                        color:#1a1d20;
                                        font-weight:600;
                                   ">
                                SubCategory Name
                            </label>

                            <input asp-for="SubCategoryName"
                                   class="form-control"
                                   style="
                                        height:48px;
                                        border-radius:6px;
                                   " />

                            <span asp-validation-for="SubCategoryName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Category -->
                        <div class="form-group mb-4">

                            <label asp-for="CategoryId"
                                   style="
                                        color:#1a1d20;
                                        font-weight:600;
                                   ">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.Categories"
                                    class="form-control"
                                    style="
                                        height:48px;
                                        border-radius:6px;
                                    ">

                                <option value="">
                                    -- Select Category --
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Current Image -->
                        <div class="form-group mb-4">

                            <label style="
                                        color:#1a1d20;
                                        font-weight:600;
                                   ">
                                Current Image
                            </label>

                            <div>
                                <img src="@Model.SubCategoryImagePath"
                                     alt="@Model.SubCategoryName"
                                     style="width:180px;height:120px;object-fit:cover;border-radius:6px;">
                            </div>

                        </div>

                        <!-- Image -->
                        <div class="form-group mb-4">

                            <label for="imageFile"
                                   style="
                                        color:#1a1d20;
                                        font-weight:600;
                                   ">
                                Replace Image (optional)
                            </label>

                            <input type="file"
                                   id="imageFile"
                                   name="imageFile"
                                   accept="image/*"
                                   class="form-control"
                                   style="
                                        height:48px;
                                        border-radius:6px;
                                   " />

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                               class="flex-c-m stext-101 size-101 bor1 hov-btn1 btn-outline-gold cl2 p-lr-15">
                                <i class="fa fa-arrow-left m-r-8"></i>
                                Back
                            </a>

                            <button type="submit"
                                    class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                                <i class="fa fa-save m-r-8"></i>
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}