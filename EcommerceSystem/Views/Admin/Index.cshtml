@using EcommerceSystem.Models
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Admin Dashboard - Watch Store";

    decimal totalRevenue = ViewBag.TotalRevenue;
    int totalOrders = ViewBag.TotalOrders;
    int totalCustomers = ViewBag.TotalCustomers;
    int lowStockCount = ViewBag.LowStockCount;
    decimal? revenueChangePercent = ViewBag.RevenueChangePercent;
    decimal? ordersChangePercent = ViewBag.OrdersChangePercent;
}

<div class="container p-t-100 p-b-100">
    <!-- رأس لوحة التحكم -->
    <div class="flex-sb-m flex-w p-b-35">
        <div>
            <h1 class="ltext-103 cl5">Admin Dashboard</h1>
            <p class="stext-102 cl6">Welcome back, @User.Identity?.Name! Monitor store performance and recent watch orders.</p>
        </div>
    </div>

    <!-- كروت الإحصائيات -->
    <div class="row g-4 p-b-30">
        <div class="col-md-3">
            <div class="p-all-20 bg6 bor4">
                <span class="stext-102 cl9">Total Revenue</span>
                <h3 class="mtext-111 cl2 p-t-10">@totalRevenue.ToString("C")</h3>
                @if (revenueChangePercent.HasValue)
                {
                    <span class="stext-109 @(revenueChangePercent >= 0 ? "cl1" : "text-danger")">
                        @(revenueChangePercent >= 0 ? "+" : "")@revenueChangePercent.Value.ToString("0.0")% from last month
                    </span>
                }
                else
                {
                    <span class="stext-109 cl6">All-time revenue</span>
                }
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-all-20 bg6 bor4">
                <span class="stext-102 cl9">Watch Orders</span>
                <h3 class="mtext-111 cl2 p-t-10">@totalOrders</h3>
                @if (ordersChangePercent.HasValue)
                {
                    <span class="stext-109 @(ordersChangePercent >= 0 ? "cl1" : "text-danger")">
                        @(ordersChangePercent >= 0 ? "+" : "")@ordersChangePercent.Value.ToString("0.0")% vs last month
                    </span>
                }
                else
                {
                    <span class="stext-109 cl6">Total orders placed</span>
                }
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-all-20 bg6 bor4">
                <span class="stext-102 cl9">Customers</span>
                <h3 class="mtext-111 cl2 p-t-10">@totalCustomers</h3>
                <span class="stext-109 cl6">Registered customers</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-all-20 bg6 bor4">
                <span class="stext-102 cl9">Low Stock Items</span>
                <h3 class="mtext-111 cl2 p-t-10 text-danger">@lowStockCount</h3>
                <span class="stext-109 text-danger">Stock remaining &lt;= 5</span>
            </div>
        </div>
    </div>

    <!-- روابط الإدارة السريعة -->
    <div class="row g-4 p-b-50">
        <div class="col-md-6">
            <div class="p-all-20 bor4 h-100 d-flex flex-column">
                <h5 class="mtext-103 cl2">Manage Customers</h5>
                <p class="stext-102 cl6 p-t-5 flex-grow-1">
                    Browse registered customers, search by name or phone, and review order activity.
                </p>
                <a asp-controller="Admin" asp-action="Customers" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 m-t-15" style="align-self:flex-start;">
                    Manage Customers
                </a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-all-20 bor4 h-100 d-flex flex-column">
                <h5 class="mtext-103 cl2">Manage Orders</h5>
                <p class="stext-102 cl6 p-t-5 flex-grow-1">
                    Search and filter orders, update order status, and preview full order details.
                </p>
                <a asp-controller="Order" asp-action="Index" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 m-t-15" style="align-self:flex-start;">
                    Manage Orders
                </a>
            </div>
        </div>
    </div>

    <!-- جدول الطلبات الحديثة -->
    <div class="p-b-30">
        <h4 class="mtext-103 cl2 p-b-20">Recent Watch Orders</h4>
        <div class="wrap-table-shopping-cart">
            <table class="table-shopping-cart">
                <tr class="table_head">
                    <th class="column-1">Order ID</th>
                    <th class="column-2">Customer</th>
                    <th class="column-3">Total Price</th>
                    <th class="column-4">Status</th>
                    <th class="column-5">Action</th>
                </tr>

                @if (!Model.Any())
                {
                    <tr class="table_row">
                        <td colspan="5" class="text-center">No orders yet</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr class="table_row">
                            <td class="column-1">@order.OrderId</td>
                            <td class="column-2">
                                @(order.Customer == null
                                    ? "-"
                                    : $"{order.Customer.FirstName} {order.Customer.LastName}")
                            </td>
                            <td class="column-3">@order.TotalPrice.ToString("C")</td>
                            <td class="column-4">
                                <span class="badge bg-info text-dark">
                                    @(order.OrderStatus?.OrderStatusName ?? "-")
                                </span>
                            </td>
                            <td class="column-5">
                                <a asp-controller="Order" asp-action="Preview" asp-route-id="@order.OrderId" class="stext-101 cl1 hov-cl1">View Details</a>
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    </div>
</div>