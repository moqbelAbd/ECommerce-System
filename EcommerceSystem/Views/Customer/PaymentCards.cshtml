@model EcommerceSystem.Models.Customer

@{
    ViewData["Title"] = "My Payment Cards";
}

<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('@Url.Content("~/images/bg-01.jpg")');">
    <h2 class="ltext-105 cl0 txt-center" style="color: black;">
        My Payment Cards
    </h2>
</section>

<section class="bg0 p-t-75 p-b-120">
    <div class="container">
        <div class="row">
            <div class="col-md-3 p-b-30">
                <partial name="_AccountMenu" />
            </div>

            <div class="col-md-9 p-b-30">
                <div class="p-all-30 bg0 bor10 hov-shadow1 trans-04">

                    <div class="d-flex align-items-center justify-content-between p-b-25 border-bottom m-b-30">
                        <div>
                            <h4 class="mtext-105 cl2">Saved Cards</h4>
                            <p class="stext-107 cl6">Manage your secure debit and credit cards.</p>
                        </div>
                        <div class="size-108 rounded-circle d-flex align-items-center justify-content-center text-white fs-20" style="background-color: #c9aa6f; width: 50px; height: 50px;">
                            <i class="fa fa-credit-card"></i>
                        </div>
                    </div>

                    <!-- عرض البطاقات المحفوظة -->
                    <div class="m-b-40">
                        <h5 class="mtext-102 cl2 p-b-15">Your Saved Cards</h5>
                        @if (Model.CustomerPaymentCards != null && Model.CustomerPaymentCards.Any())
                        {
                            <ul class="list-group">
                                @foreach (var card in Model.CustomerPaymentCards)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg6 bor8 m-b-10 p-lr-20" style="padding: 15px 20px; border-radius: 8px;">
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-cc-visa m-r-15 fs-24" style="color: #c9aa6f;"></i>
                                            <div>
                                                <span class="mtext-107 cl2">**** **** **** @(card.CardNumber.Length > 4 ? card.CardNumber.Substring(card.CardNumber.Length - 4) : card.CardNumber)</span>
                                                <span class="d-block stext-107 cl6">Expires: @card.CardExpire</span>
                                            </div>
                                        </div>
                                        <form asp-controller="Customer" asp-action="DeletePaymentCard" method="post">
                                            <input type="hidden" name="cardId" value="@card.PaymentCardId" />
                                            <button type="submit" class="btn text-danger"><i class="fa fa-trash"></i></button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted stext-107">No saved debit cards found.</p>
                        }
                    </div>

                    <!-- نموذج إضافة بطاقة جديدة -->
                    <div class="border-top p-t-35">
                        <h5 class="mtext-102 cl2 p-b-20">Add New Card</h5>
                        <form asp-controller="Customer" asp-action="AddPaymentCard" method="post">
                            <div class="row">
                                <div class="col-md-12 p-b-20">
                                    <label class="stext-102 cl2 p-b-5">Name on Card</label>
                                    <div class="bor8 bg0"><input type="text" name="cardHolderName" class="stext-111 cl8 size-111 p-lr-15" required /></div>
                                </div>
                                <div class="col-md-12 p-b-20">
                                    <label class="stext-102 cl2 p-b-5">Card Number</label>
                                    <div class="bor8 bg0"><input type="text" name="cardNumber" class="stext-111 cl8 size-111 p-lr-15" maxlength="16" required /></div>
                                </div>
                                <div class="col-md-6 p-b-20">
                                    <label class="stext-102 cl2 p-b-5">Expiration Date</label>
                                    <div class="bor8 bg0"><input type="date" name="cardExpire" class="stext-111 cl8 size-111 p-lr-15" required /></div>
                                </div>
                                <div class="col-md-6 p-b-20">
                                    <label class="stext-102 cl2 p-b-5">CVV</label>
                                    <div class="bor8 bg0">
                                        <input type="password" name="dummyCVV" class="stext-111 cl8 size-111 p-lr-15" placeholder="3 digits" maxlength="4" required />
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="flex-c-m stext-101 cl0 size-118 bg1 bor1 hov-btn1 p-lr-15 trans-04 pointer" style="background-color: #c9aa6f; color: #1a1d20; font-weight: 700; border-radius: 8px;">Add Card</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>