@model CartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container p-t-100 p-b-20">
    <div class="bread-crumb flex-w p-l-25 p-r-15 p-lr-0-lg">
        <a asp-controller="Home" asp-action="Index" class="stext-109 cl8 hov-cl1 trans-04">
            Home
            <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
        </a>

        <span class="stext-109 cl4">
            Shopping Cart
        </span>
    </div>
</div>

<!-- Shopping Cart -->
<form asp-controller="Cart" asp-action="UpdateCart" method="post" class="bg0 p-t-25 p-b-85">
    <div class="container">
        <div class="row">
            <!-- Products list -->
            <div class="col-lg-10 col-xl-7 m-lr-auto m-b-50">
                <div class="m-l-25 m-r--38 m-lr-0-xl">
                    <div class="wrap-table-shopping-cart">
                        <table class="table-shopping-cart">
                            <tr class="table_head">
                                <th class="column-1">Product</th>
                                <th class="column-2"></th>
                                <th class="column-3">Price</th>
                                <th class="column-4">Quantity</th>
                                <th class="column-5">Total</th>
                                <th  class="column-6"></th>
                            </tr>

                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center p-t-40 p-b-40 stext-111 cl6">
                                        Your cart is currently empty.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="table_row">
                                        <td class="column-1">
                                            <div class="how-itemcart1" style="width: 60px; height: 80px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #fff;">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                            </div>
                                        </td>
                                        <td class="column-2" style="font-weight: 500;">@item.ProductName</td>
                                        <td class="column-3">$@item.Price.ToString("0.00")</td>
                                        <td class="column-4">
                                            <div class="wrap-num-product flex-w m-l-auto m-r-0">
                                                <div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m">
                                                    <i class="fs-16 zmdi zmdi-minus"></i>
                                                </div>

                                                <input class="mtext-104 cl3 txt-center num-product" 
                                                       type="number" 
                                                       name="quantities[@item.ProductId]" 
                                                       value="@item.Quantity">

                                                <div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m">
                                                    <i class="fs-16 zmdi zmdi-plus"></i>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="column-5">$@item.Total.ToString("0.00")</td>

                                          <td class="column-6" style="vertical-align: middle; text-align: center; padding-right: 20px;">
                                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" style="margin: 0; display: flex; justify-content: center; height: 100%;">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
        
                                            <button type="submit" title="Remove Item" style="background: transparent; border: none; cursor: pointer; padding: 10px; display: inline-flex; align-items: center; justify-content: center; color: #dc3545; transition: transform 0.2s;">
                                                <i class="fs-22 zmdi zmdi-delete"></i>
                                            </button>
                                        </form>
                                    </td>
                                    </tr>
                                }
                            }
                        </table>
                    </div>

                    <div class="flex-w flex-sb-m bor15 p-t-18 p-b-15 p-lr-40 p-lr-15-sm" style="justify-content: flex-end;">
                        <button type="submit" asp-controller= "Cart" asp-action="UpdateCart" class="flex-c-m stext-101 cl2 size-119 bg8 bor13 hov-btn3 p-lr-15 trans-04 pointer m-tb-10">
                            Update Cart
                        </button>
                    </div>
                </div>
            </div>

            <!-- Cart info -->
            <div class="col-sm-10 col-lg-7 col-xl-5 m-lr-auto m-b-50">
                <div class="bor10 p-lr-40 p-t-30 p-b-40 m-l-63 m-r-40 m-lr-0-xl p-lr-15-sm" style="border-radius: 12px;">
                    <h4 class="mtext-109 cl2 p-b-30" style="font-weight: 600;">
                        Cart Totals
                    </h4>

                    <div class="flex-w flex-t bor12 p-b-13">
                        <div class="size-208">
                            <span class="stext-110 cl2">Subtotal:</span>
                        </div>
                        <div class="size-209">
                            <span class="mtext-110 cl2">$@Model.CartTotal.ToString("0.00")</span>
                        </div>
                    </div>

                    <div class="flex-w flex-t p-t-27 p-b-33">
                        <div class="size-208">
                            <span class="mtext-101 cl2">Total:</span>
                        </div>
                        <div class="size-209 p-t-1">
                            <span class="mtext-110 cl2" style="color: #222; font-weight: bold;">
                                $@Model.CartTotal.ToString("0.00")
                            </span>
                        </div>
                    </div>

                    @if (Model.Items.Any())
                    {
                        <a asp-controller="Customer" asp-action="Checkout" class="flex-c-m stext-101 cl0 size-116 bg1 bor1 hov-btn1 p-lr-15 trans-04 pointer" style="border-radius: 8px; font-weight: 600; text-decoration: none;">
                            Proceed to Checkout
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</form>