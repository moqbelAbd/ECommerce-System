@{
    ViewData["Title"] = "My Wishlist - Rolexyal";
}

<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('@Url.Content("~/images/bg-01.jpg")');">
    <h2 class="ltext-105 cl0 txt-center" style="color: black;">
        My Wishlist
    </h2>
</section>

<section class="bg0 p-t-75 p-b-120">
    <div class="container">
        <div class="row">

            <div class="col-md-3 p-b-30">
                <div class="p-all-20 bg6 bor4">
                    <h5 class="mtext-102 cl2 p-b-20 border-bottom">Account Menu</h5>
                    <ul class="nav flex-column p-t-10">
                        <li class="nav-item m-b-10">
                            <a asp-controller="Home" asp-action="Profile" class="stext-102 cl6 hov-cl1 trans-04 d-block p-tb-8 p-lr-15" style="text-decoration: none;">
                                <i class="fa fa-user-o m-r-10"></i> Profile Information
                            </a>
                        </li>
                        <li class="nav-item m-b-10">
                            <a asp-controller="Customer" asp-action="OrderHistory" class="stext-102 cl6 hov-cl1 trans-04 d-block p-tb-8 p-lr-15" style="text-decoration: none;">
                                <i class="fa fa-shopping-bag m-r-10"></i> My Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Customer" asp-action="Wishlist" class="stext-102 cl1 hov-cl1 trans-04 d-block p-tb-8 p-lr-15 bg0 bor8" style="text-decoration: none; font-weight: 600;">
                                <i class="fa fa-heart-o m-r-10"></i> Wishlist
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- محتوى قائمة الأمنيات -->
            <div class="col-md-9 p-b-30">
                <div class="p-all-30 bg0 bor10 hov-shadow1 trans-04">
                    <div class="p-b-25 border-bottom m-b-30">
                        <h4 class="mtext-105 cl2">Saved Favorite Items</h4>
                        <p class="stext-107 cl6">Quickly review the luxury pieces you love and move them to your cart.</p>
                    </div>

                    <div class="wrap-table-shopping-cart" style="border: 1px solid #e6e6e6; border-radius: 8px; overflow: hidden; background: #fff;">
                        <table class="table-shopping-cart" style="width: 100%; border-collapse: collapse;">
                            <tr class="table_head" style="background-color: #f8f9fa;">
                                <th class="column-1" style="padding-left: 20px;">Product</th>
                                <th class="column-2">Product Name</th>
                                <th class="column-3">Price</th>
                                <th class="column-4" style="text-align: center;">Stock Status</th>
                                <th class="column-5" style="text-align: right; padding-right: 20px;">Actions</th>
                            </tr>

                            <tr class="table_row" style="border-top: 1px solid #f1f1f1;">
                                <td class="column-1" style="padding-left: 20px; padding-top: 15px; padding-bottom: 15px;">
                                    <div class="how-itemcart1" style="width: 50px; height: 70px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #fcfcfc; border-radius: 6px;">
                                        <img src="~/images/Men/Watch10/timberland-watch.png" alt="TIMBERLAND WATCH" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                    </div>
                                </td>
                                <td class="column-2" style="font-weight: 500; color: #111;">Timberland Classic Men Watch</td>
                                <td class="column-3" style="font-weight: 600; color: #111;">$145.00</td>
                                <td class="column-4" style="text-align: center;">
                                    <span class="badge" style="background-color: #e2f0d9; color: #385723; padding: 5px 10px; border-radius: 20px; font-weight: 500; font-size: 11px;">
                                        In Stock
                                    </span>
                                </td>
                                <td class="column-5" style="text-align: right; padding-right: 20px;">
                                    <div class="flex-w flex-m justify-content-end" style="gap: 6px;">
                                        <a href="#" class="flex-c-m stext-101 cl0 size-107 bg1 bor1 hov-btn1 p-lr-15 trans-04 pointer" style="display: inline-flex; height: 34px; font-size: 11px; border-radius: 6px; text-decoration: none;">
                                            Add To Cart
                                        </a>
                                        <a href="#" class="flex-c-m stext-101 cl2 size-108 bg2 bor13 hov-btn3 p-lr-15 trans-04 pointer" style="display: inline-flex; width: 34px; height: 34px; border-radius: 6px; color: #dc3545; border-color: #dc3545;" title="Remove">
                                            <i class="fa fa-trash-o"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            <tr class="table_row" style="border-top: 1px solid #f1f1f1;">
                                <td class="column-1" style="padding-left: 20px; padding-top: 15px; padding-bottom: 15px;">
                                    <div class="how-itemcart1" style="width: 50px; height: 70px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #fcfcfc; border-radius: 6px;">
                                        <img src="~/images/Women/Watch5/watch5-daniel-klein.png" alt="DANIEL KLEIN WATCH" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                    </div>
                                </td>
                                <td class="column-2" style="font-weight: 500; color: #111;">Daniel Klein Elegant Women Watch</td>
                                <td class="column-3" style="font-weight: 600; color: #111;">$95.00</td>
                                <td class="column-4" style="text-align: center;">
                                    <span class="badge" style="background-color: #e2f0d9; color: #385723; padding: 5px 10px; border-radius: 20px; font-weight: 500; font-size: 11px;">
                                        In Stock
                                    </span>
                                </td>
                                <td class="column-5" style="text-align: right; padding-right: 20px;">
                                    <div class="flex-w flex-m justify-content-end" style="gap: 6px;">
                                        <a href="#" class="flex-c-m stext-101 cl0 size-107 bg1 bor1 hov-btn1 p-lr-15 trans-04 pointer" style="display: inline-flex; height: 34px; font-size: 11px; border-radius: 6px; text-decoration: none;">
                                            Add To Cart
                                        </a>
                                        <a href="#" class="flex-c-m stext-101 cl2 size-108 bg2 bor13 hov-btn3 p-lr-15 trans-04 pointer" style="display: inline-flex; width: 34px; height: 34px; border-radius: 6px; color: #dc3545; border-color: #dc3545;" title="Remove">
                                            <i class="fa fa-trash-o"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    @@media (max-width: 992px) {
        .table-shopping-cart {
            min-width: 750px;
        }
    }
</style>