@using EcommerceSystem.Models
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Shop Products";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    Guid? selectedCategoryId = ViewBag.SelectedCategoryId;
    Guid? selectedSubCategoryId = ViewBag.SelectedSubCategoryId;
    string? searchTerm = ViewBag.SearchTerm;
}

<!-- Product -->
<div class="bg0 m-t-23 p-b-140">
    <div class="container">
        <div class="flex-w flex-sb-m p-b-52">
            <div class="flex-w flex-l-m filter-tope-group m-tb-10">
                <a asp-controller="Customer" asp-action="Index"
                   class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 @(selectedCategoryId == null && selectedSubCategoryId == null ? "how-active1" : "")">
                    All Products
                </a>

                @foreach (var category in categories)
                {
                    <a asp-controller="Customer" asp-action="Index" asp-route-categoryId="@category.CategoryId"
                       class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 @(selectedCategoryId == category.CategoryId ? "how-active1" : "")">
                        @category.CategoryName
                    </a>
                }
            </div>

            <!-- Search product -->
            <div class="flex-w flex-c-m m-tb-10">
                <form asp-controller="Customer" asp-action="Search" method="get" class="bor8 dis-flex p-l-15">
                    <button type="submit" class="size-113 flex-c-m fs-16 cl2 hov-cl1 trans-04">
                        <i class="zmdi zmdi-search"></i>
                    </button>

                    <input class="mtext-107 cl2 size-114 plh2 p-r-15" type="text" name="term" value="@searchTerm" placeholder="Search products or categories">
                </form>
            </div>
        </div>

        @if (categories.Any(c => c.subCategories.Any()))
        {
            <div class="flex-w flex-l-m p-b-30">
                <a asp-controller="Customer" asp-action="Index"
                   class="stext-107 cl6 hov1 bor7 trans-04 m-r-10 m-b-10 p-lr-10 @(selectedSubCategoryId == null ? "how-active1" : "")">
                    All Subcategories
                </a>
                @foreach (var subCategory in categories.SelectMany(c => c.subCategories))
                {
                    <a asp-controller="Customer" asp-action="Index" asp-route-subCategoryId="@subCategory.SubCategoryId"
                       class="stext-107 cl6 hov1 bor7 trans-04 m-r-10 m-b-10 p-lr-10 @(selectedSubCategoryId == subCategory.SubCategoryId ? "how-active1" : "")">
                        @subCategory.SubCategoryName
                    </a>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <div class="p-b-20">
                <span class="stext-106 cl6">Search results for "@searchTerm" (@Model.Count() found)</span>
            </div>
        }

        <!-- Products Grid -->
        @if (!Model.Any())
        {
            <div class="p-t-30 p-b-30">
                <span class="stext-106 cl6">No products found.</span>
            </div>
        }
        else
        {
            <div class="row isotope-grid">
                @foreach (var product in Model)
                {
                    var imagePath = product.ProductImages.FirstOrDefault()?.ProductImagepath ?? "~/images/product-01.jpg";
                    var productName = product.ProductDescription
                        ?? $"{product.ProductBrand?.BrandName} {product.ProductModel?.ModelName}".Trim();

                    <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item">
                        <div class="block2">
                            <div class="block2-pic hov-img0">
                                <img src="@imagePath" alt="@productName">
                                <a asp-controller="Customer" asp-action="Details" asp-route-id="@product.ProductId"
                                   class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                                    View Details
                                </a>
                            </div>

                            <div class="block2-txt flex-w flex-t p-t-14">
                                <div class="block2-txt-child1 flex-col-l">
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@product.ProductId"
                                       class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                                        @productName
                                    </a>
                                    <span class="stext-105 cl3">@product.ProductPrice.ToString("C")</span>
                                    @if (product.ProductQuantity <= 0)
                                    {
                                        <span class="stext-107 cl11">Out of stock</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
