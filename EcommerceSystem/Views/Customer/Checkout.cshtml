@model EcommerceSystem.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container m-t-60 p-b-140">
<form id="checkoutForm" class="row">
    <!-- Left Side: Order Items Review -->
    <div class="col-lg-7 m-b-50">

        <div class="bor10 p-lr-40 p-t-35 p-b-40" style="border-radius: 12px; background: #fff; border: 1px solid #e6e6e6;">
            <h4 class="mtext-109 cl2 p-b-25" style="font-weight: 600;">Order Review</h4>
        
            <div class="table-responsive p-b-20">
                <table style="width: 100%; border-collapse: collapse; min-width: 450px;">
                    <tr style="border-bottom: 2px solid #f2f2f2;">
                        <th style="padding: 15px; text-align: left; font-size: 13px; color: #555; width: 55%;">Product</th>
                        <th style="padding: 15px; text-align: center; font-size: 13px; color: #555; width: 20%;">Price</th>
                        <th style="padding: 15px; text-align: center; font-size: 13px; color: #555; width: 15%;">Qty</th>
                        <th style="padding: 15px; text-align: center; width: 10%;"></th>
                    </tr>

                    @foreach (var item in Model.Cart.Items)
                    {
                        <tr style="border-bottom: 1px solid #f2f2f2;">
                        
                            <!-- Product (Image + Title) -->
                            <td style="padding: 15px; display: flex; align-items: center; gap: 15px;">
                                <div style="width: 60px; height: 60px; flex-shrink: 0; background: #fcfcfc; border-radius: 6px; border: 1px solid #eee; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                    <img src="@item.ImageUrl" alt="@item.ProductName" style="max-width: 90%; max-height: 90%; object-fit: contain;">
                                </div>
                                <div>
                                    <span style="font-weight: 500; font-size: 14px; color: #333; display: block; line-height: 1.3;">@item.ProductName</span>
                                    <!-- STOCK ERROR CONTAINER -->
                                    <div id="stock-error-@item.ProductId" class="text-danger p-t-5" style="font-size: 11px; font-weight: bold;"></div>
                                </div>
                            </td>
                        
                            <!-- Price -->
                            <td style="padding: 15px; text-align: center; font-size: 14px; font-weight: 500; color: #555;">
                                $@item.Price.ToString("0.00")
                            </td>
                        
                            <!-- Quantity Box -->
                            <td style="padding: 15px;">
                                <div class="wrap-num-product flex-w m-auto" style="width: 90px; height: 35px; border-radius: 4px; border: 1px solid #e6e6e6;">
                                    <div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m ajax-qty-update" style="width: 28px; height: 100%; cursor: pointer;">
                                        <i class="fs-16 zmdi zmdi-minus"></i>
                                    </div>
                                
                                    <input class="mtext-104 cl3 txt-center num-product" type="number" value="@item.Quantity" data-product-id="@item.ProductId" style="width: 32px; height: 100%; font-size: 14px; background: transparent; border-left: 1px solid #e6e6e6; border-right: 1px solid #e6e6e6;" readonly>
                                
                                    <div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m ajax-qty-update" style="width: 28px; height: 100%; cursor: pointer;">
                                        <i class="fs-16 zmdi zmdi-plus"></i>
                                    </div>
                                </div>
                            </td>
                        
                            <!-- Delete Button -->
                            <td style="padding: 15px; text-align: center;">
                                <button type="button" class="ajax-remove-btn" data-product-id="@item.ProductId" style="color: #dc3545; background: none; border: none; font-size: 20px; cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                                    <i class="zmdi zmdi-delete"></i>
                                </button>
                            </td>
                        
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>

    <!-- Right Side: Location & Payment -->
    <div class="col-lg-5 m-b-50">
        <div class="bor10 p-lr-30 p-t-35 p-b-40" style="border-radius: 12px; background: #fff;">
            <h4 class="mtext-109 cl2 p-b-15" style="font-weight: 600;">Delivery Location</h4>
            <div class="m-b-20">
                <label class="stext-102 cl6 p-b-5 block" style="font-weight: 500;">Address</label>
                <div class="bor8 bg0">
                    <input class="stext-111 cl8 plh3 size-111 p-lr-15" type="text" name="location" value="@Model.Customer.Location" required />
                </div>
            </div>

            <hr style="border-top: 1px solid #e0e0e0; margin: 25px 0;">

            <h4 class="mtext-109 cl2 p-b-15" style="font-weight: 600;">Payment</h4>
            <div class="p-t-10 p-b-20">
                <div class="form-check m-b-10">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="cashOnDelivery" value="Cash" checked onclick="togglePaymentSection()">
                    <label class="form-check-label stext-111 cl6" for="cashOnDelivery">Cash on Delivery</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="visaCard" value="Visa" onclick="togglePaymentSection()">
                    <label class="form-check-label stext-111 cl6" for="visaCard">Visa / Credit Card</label>
                </div>
            </div>

            <!-- THE VISA DETAILS SECTION -->
            <div id="visaDetailsSection" style="display: none; background: #f9f9f9; padding: 20px; border-radius: 10px; border: 1px solid #e5e5e5; margin-bottom: 25px;">
                <h6 class="stext-110 cl2 p-b-12" style="font-weight: 600;">Saved Cards</h6>
                @if (Model.Customer.CustomerPaymentCards != null && Model.Customer.CustomerPaymentCards.Any())
                {
                    @foreach (var card in Model.Customer.CustomerPaymentCards)
                    {
                        <div class="form-check m-b-10" style="padding-left: 25px;">
                            <input class="form-check-input" type="radio" name="selectedCardId" id="card_@card.PaymentCardId" value="@card.PaymentCardId">
                            <label class="form-check-label stext-111 cl6" for="card_@card.PaymentCardId" style="cursor: pointer;">
                                💳 @card.CardHolderName - ending in <b>@(card.CardNumber.Length > 4 ? card.CardNumber.Substring(card.CardNumber.Length - 4) : card.CardNumber)</b>
                            </label>
                        </div>
                    }
                }
                else
                {
                    <p class="stext-111 cl6 m-b-15">No saved cards found.</p>
                }

                <hr style="border-top: 1px solid #e0e0e0; margin: 15px 0;">

                <h6 class="stext-110 cl2 p-b-12" style="font-weight: 600;">Or Add a New Card</h6>
                <div class="m-b-12">
                    <input class="stext-111 cl8 plh3 size-111 p-lr-15 bg0" style="border: 1px solid #e6e6e6; border-radius: 6px;" type="text" name="newCardHolderName" placeholder="Name on Card">
                </div>
                <div class="m-b-12">
                    <input class="stext-111 cl8 plh3 size-111 p-lr-15 bg0" style="border: 1px solid #e6e6e6; border-radius: 6px;" type="text" name="newCardNumber" placeholder="Card Number (16 digits)" maxlength="16">
                </div>
                <div class="row">
                    <div class="col-7 m-b-12">
                        <input class="stext-111 cl8 plh3 size-111 p-lr-15 bg0" style="border: 1px solid #e6e6e6; border-radius: 6px;" type="date" name="newCardExpire">
                    </div>
                    <div class="col-5 m-b-12">
                        <input class="stext-111 cl8 plh3 size-111 p-lr-15 bg0" style="border: 1px solid #e6e6e6; border-radius: 6px;" type="password" name="dummyCVV" placeholder="CVV" maxlength="4">
                    </div>
                </div>
            </div>

            <button type="submit" id="placeOrderBtn" class="flex-c-m stext-101 cl0 size-116 bg1 bor1 hov-btn1 p-lr-15 trans-04 pointer" style="background-color: #c9aa6f; border-radius: 8px; font-weight: 700;">
                Place Order
            </button>
        </div>
    </div>
</form>
</div>

@section Scripts {
 <script>
    function togglePaymentSection() {
        var visaSection = document.getElementById('visaDetailsSection');
        var visaRadio = document.getElementById('visaCard');
        visaSection.style.display = visaRadio.checked ? 'block' : 'none';
    }

    document.addEventListener("DOMContentLoaded", function() {

        const checkoutForm = document.getElementById("checkoutForm");
        if (checkoutForm) {
            checkoutForm.addEventListener("submit", function(e) {
                e.preventDefault();
                
                const submitBtn = document.getElementById('placeOrderBtn');
                if (submitBtn) {
                    if (submitBtn.style.pointerEvents === 'none') return;
                    submitBtn.style.pointerEvents = 'none';
                    submitBtn.style.opacity = '0.5';
                }

                document.querySelectorAll('[id^="stock-error-"]').forEach(el => el.innerText = '');

                const liveQuantities = {};
                document.querySelectorAll('.num-product').forEach(input => {
                    const id = input.getAttribute("data-product-id");
                    liveQuantities[id] = parseInt(input.value);
                });

                const formData = new FormData(checkoutForm);
                const expireDate = formData.get("newCardExpire");
                const cardId = formData.get("selectedCardId");

                const payload = {
                    Location: formData.get("location"),
                    PaymentMethod: formData.get("paymentMethod"),
                    SelectedCardId: cardId ? cardId : null, 
                    NewCardHolderName: formData.get("newCardHolderName"),
                    NewCardNumber: formData.get("newCardNumber"),
                    NewCardExpire: expireDate ? expireDate : null, 
                    DummyCVV: formData.get("dummyCVV"),
                    SaveNewCard: true, // حفظ البطاقة الجديدة تلقائياً
                    Quantities: liveQuantities 
                };

                fetch('/Customer/PlaceOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        if (typeof showToast === 'function') showToast(data.message, "success");
                        setTimeout(() => { window.location.href = `/Customer/OrderConfirmation?id=${data.orderId}`; }, 1200);
                    } else {
                        if (typeof showToast === 'function') showToast(data.message, "error");
                        if (data.errors && data.errors.length > 0) {
                            data.errors.forEach(err => {
                                const errorDiv = document.getElementById(`stock-error-${err.productId}`);
                                if (errorDiv) errorDiv.innerText = err.message;
                            });
                        }
                    }
                })
                .catch(error => console.error('Error:', error))
                .finally(() => {
                    if (submitBtn) {
                        submitBtn.style.pointerEvents = 'auto';
                        submitBtn.style.opacity = '1';
                    }
                });
            });
        }

        document.body.addEventListener("click", function(e) {
            const removeBtn = e.target.closest(".ajax-remove-btn");
            if (!removeBtn) return;
            e.preventDefault();
            
            if (removeBtn.style.pointerEvents === 'none') return;
            removeBtn.style.pointerEvents = 'none';
            removeBtn.style.opacity = '0.5';

            fetch(`/Cart/RemoveFromCart?productId=${removeBtn.getAttribute("data-product-id")}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (typeof showToast === 'function') showToast(data.message, "warning");
                    setTimeout(() => { location.reload(); }, 500);
                }
            });
        });
    });
</script>
}