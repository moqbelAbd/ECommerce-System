@{
    ViewData["Title"] = "Complete Profile";
}

<div class="container-fluid px-0 bg0" style="min-height: 80vh; display: flex; align-items: stretch;">
    <div class="row g-0 w-100">

        <div class="col-lg-5 d-flex align-items: center justify-content-center p-tb-60 p-lr-30 bg0">
            <div class="w-100" style="max-width: 440px;">

                <form asp-controller="Customer" asp-action="CompleteProfile" method="post" class="bor10 p-lr-40 p-tb-40" style="border-radius: 16px; border: 1px solid rgba(0,0,0,0.06); background: #fff;">

                    <div class="text-center p-b-35">
                        <h3 class="mtext-111 cl2 p-b-8" style="font-weight: 600; letter-spacing: 1px;">
                            Welcome!
                        </h3>
                        <p class="stext-113 cl6" style="font-size: 14px;">
                            Please complete your profile to continue.
                        </p>
                    </div>

                    <div class="m-b-20">
                        <label class="stext-102 cl6 p-b-5 block" style="font-weight: 500;">First Name</label>
                        <div class="bor8" style="border-radius: 10px; background: #fafafa; border: 1px solid #e5e5e5;">
                            <input type="text" name="firstName" required class="stext-111 cl2 plh3 size-116 p-l-20 p-r-20" placeholder="John" style="border: none; background: transparent; width: 100%; height: 45px;" />
                        </div>
                    </div>

                    <div class="m-b-20">
                        <label class="stext-102 cl6 p-b-5 block" style="font-weight: 500;">Last Name</label>
                        <div class="bor8" style="border-radius: 10px; background: #fafafa; border: 1px solid #e5e5e5;">
                            <input type="text" name="lastName" required class="stext-111 cl2 plh3 size-116 p-l-20 p-r-20" placeholder="Doe" style="border: none; background: transparent; width: 100%; height: 45px;" />
                        </div>
                    </div>

                    <div class="m-b-25">
                        <label class="stext-102 cl6 p-b-5 block" style="font-weight: 500;">Location</label>
                        <div class="bor8" style="border-radius: 10px; background: #fafafa; border: 1px solid #e5e5e5;">
                            <input type="text" name="location" class="stext-111 cl2 plh3 size-116 p-l-20 p-r-20" placeholder="City, Country" style="border: none; background: transparent; width: 100%; height: 45px;" />
                        </div>
                    </div>

                    <button type="submit" class="flex-c-m stext-101 cl0 size-121 bg1 bor1 hov-btn1 p-lr-15 trans-04 pointer w-full" style="border-radius: 10px; font-weight: 600; letter-spacing: 1px; height: 50px;">
                        SAVE AND CONTINUE
                    </button>
                </form>

            </div>

        </div>

        <div class="col-lg-7 d-none d-lg-block position-relative overflow-hidden" style="background-image: url('/images/about-02.jpg'); background-size: cover; background-position: center; min-height: 650px;">
        </div>

    </div>
</div>

