@model IEnumerable<EcommerceSystem.Models.Order>

@{
    ViewData["Title"] = "Order History - Rolexyal";
}

<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('@Url.Content("~/images/bg-01.jpg")');">
    <h2 class="ltext-105 cl0 txt-center" style="color: black;">
        My Orders
    </h2>
</section>

<section class="bg0 p-t-75 p-b-120">
    <div class="container">
        <div class="row">
            <div class="col-md-3 p-b-30">
                <partial name="_AccountMenu" />
            </div>

            <div class="col-md-9 p-b-30">
                <div class="p-all-30 bg0 bor10 hov-shadow1 trans-04">
                    <div class="p-b-25 border-bottom m-b-30">
                        <h4 class="mtext-105 cl2">Your Past Orders</h4>
                        <p class="stext-107 cl6">Track, review, and check the status of your luxury purchases.</p>
                    </div>

                    <div class="wrap-table-shopping-cart" style="border: 1px solid #e6e6e6; border-radius: 8px; overflow: hidden; background: #fff;">
                        <table class="table-shopping-cart" style="width: 100%; border-collapse: collapse;">
                            <tr class="table_head" style="background-color: #f8f9fa;">
                                <th class="column-1" style="padding-left: 20px;">Order ID</th>
                                <th class="column-2">Date</th>
                                <th class="column-3">Ship to</th>
                                <th class="column-4">Status</th>
                                <th class="column-5" style="text-align: right; padding-right: 20px;">Total</th>
                                <th class="column-6" style="text-align: center; padding-right: 15px;">Actions</th>
                            </tr>

                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center p-t-40 p-b-40 stext-111 cl6">
                                        You have no past orders.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var order in Model)
                                {
                                    // Generate a short ID from the Guid (e.g., first 8 characters)
                                    string shortOrderId = order.OrderId.ToString().Substring(0, 8).ToUpper();
                                    
                                    // Dynamic Badge Styling
                                    string badgeBg = "#fff2cc"; // Default Yellow
                                    string badgeColor = "#806000";
                                    string statusName = order.OrderStatus?.OrderStatusName ?? "Processing";

                                    if (order.OrderStatusId == 1) { badgeBg = "#fff2cc"; badgeColor = "#806000"; statusName = "Pending"; }
                                    else if (order.OrderStatusId == 2) { badgeBg = "#e2e3e5"; badgeColor = "#383d41"; statusName = "Processing"; }
                                    else if (order.OrderStatusId == 3) { badgeBg = "#fce4d6"; badgeColor = "#c65911"; statusName = "Shipped"; }
                                    else if (order.OrderStatusId == 4) { badgeBg = "#e2f0d9"; badgeColor = "#385723"; statusName = "Delivered"; }

                                    <tr class="table_row" style="border-top: 1px solid #f1f1f1;">
                                        <td class="column-1" style="padding-left: 20px; font-weight: 600; color: #111;">#RX-@shortOrderId</td>
                                        <td class="column-2" style="color: #666;">@order.CreatedAt.ToString("MMMM dd, yyyy")</td>
                                        <td class="column-3" style="color: #555;">@order.Location</td>
                                        <td class="column-4">
                                            <span class="badge" style="background-color: @badgeBg; color: @badgeColor; padding: 5px 10px; border-radius: 20px; font-weight: 500; font-size: 11px;">
                                                @statusName
                                            </span>
                                        </td>
                                        <td class="column-5" style="text-align: right; padding-right: 20px; font-weight: 600; color: #111;">$@order.TotalPrice.ToString("0.00")</td>
                                        <td class="column-6" style="text-align: center; padding-right: 15px;">
                                            <a asp-controller="Customer" asp-action="OrderDetails" asp-route-id="@order.OrderId" class="flex-c-m stext-101 cl0 size-107 bg1 bor1 hov-btn1 p-lr-15 trans-04 pointer" style="display: inline-flex; height: 32px; font-size: 11px; border-radius: 6px; text-decoration: none;">
                                                View Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @@media (max-width: 992px) {
        .table-shopping-cart { min-width: 750px; }
    }
</style>