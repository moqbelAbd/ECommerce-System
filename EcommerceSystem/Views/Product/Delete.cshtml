@model EcommerceSystem.Models.Product

@{
    ViewData["Title"] = !Model.IsDeleted ? "Delete Product" : "Restore Product";
    var imagePath = Model.ProductImages?.FirstOrDefault()?.ProductImagePath;
}

<div class="bg0 p-t-80 p-b-100">
    <div class="container" style="max-width: 760px;">
        <div class="bor10 p-all-30">

            <div class="text-center m-b-30">
                @if (!Model.IsDeleted)
                {
                    <i class="fa fa-exclamation-triangle text-danger" style="font-size: 42px;"></i>
                    <h1 class="ltext-103 cl5 p-t-15">Delete Product</h1>
                    <p class="stext-102 cl6 p-t-10">This product will be hidden from the catalog. Its existing records are not removed.</p>
                }
                else
                {
                    <i class="fa fa-undo text-success" style="font-size: 42px;"></i>
                    <h1 class="ltext-103 cl5 p-t-15">Restore Product</h1>
                    <p class="stext-102 cl6 p-t-10">This product will be restored to the active catalog and visible to customers.</p>
                }
            </div>

            <!-- Product Preview Card -->
            <div class="row align-items-center m-b-30 p-all-20" style="background: #f8f9fa; border-radius: 8px;">
                <div class="col-sm-4 text-center m-b-20 m-sm-b-0">
                    @if (!string.IsNullOrWhiteSpace(imagePath))
                    {
                        <img src="@Url.Content(imagePath)"
                             alt="@Model.ProductName"
                             class="img-fluid bor10"
                             style="max-height: 170px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bor10 d-flex align-items-center justify-content-center bg-white" style="height: 170px; border: 1px solid #eee;">
                            <i class="fa fa-image text-muted fa-2x"></i>
                        </div>
                    }
                </div>

                <div class="col-sm-8">
                    <h3 class="mtext-110 cl2">@Model.ProductName</h3>
                    <p class="stext-102 cl6 m-b-10">@(Model.ProductBrand?.BrandName ?? "-") · @(Model.ProductModel?.ModelName ?? "-")</p>
                    <p class="mtext-106 cl2 m-b-10">@Model.ProductPrice.ToString("C")</p>
                    <p class="stext-102 cl6">Stock: @Model.ProductQuantity</p>
                </div>
            </div>

            <!-- Dynamic Form Section -->
            @if (!Model.IsDeleted)
            {
                <form asp-action="Delete" asp-route-id="@Model.ProductId" method="post" class="d-flex justify-content-center gap-2">
                    <input type="hidden" name="id" value="@Model.ProductId" />

                    <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 20px;">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 py-2" style="border-radius: 20px;">
                        <i class="fa fa-trash m-r-6"></i> Yes, delete product
                    </button>
                </form>
            }
            else
            {
                <form asp-action="UnDelete" asp-route-id="@Model.ProductId" method="post" class="d-flex justify-content-center gap-2">
                    <input type="hidden" name="id" value="@Model.ProductId" />

                    <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 20px;">Cancel</a>
                    <button type="submit" class="btn btn-success px-4 py-2" style="border-radius: 20px;">
                        <i class="fa fa-undo m-r-6"></i> Yes, restore product
                    </button>
                </form>
            }

        </div>
    </div>
</div>