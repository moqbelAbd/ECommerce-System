@using EcommerceSystem.Models
@model Product

@{
    ViewData["Title"] = "Add Product";

    var brands = ViewBag.Brands as List<ProductBrand> ?? new List<ProductBrand>();
    var models = ViewBag.Models as List<ProductModel> ?? new List<ProductModel>();
    var subCategories = ViewBag.SubCategories as List<SubCategory> ?? new List<SubCategory>();
    Guid? selectedSubCategoryId = ViewBag.SelectedSubCategoryId is Guid id ? id : null;
}

<div class="bg0 p-t-80 p-b-100">
    <div class="container" style="max-width: 900px;">
        <div class="flex-sb-m flex-w p-b-35">
            <div>
                <h1 class="ltext-103 cl5">Add Product</h1>
                <p class="stext-102 cl6 p-t-5">Create a product for your store catalog.</p>
            </div>

            <a asp-action="Index" class="flex-c-m stext-101 size-101 bor1 hov-btn1 btn-outline-gold cl2 p-lr-15 m-tb-10">
                <i class="fa fa-arrow-left m-r-6"></i> Back to products
            </a>
        </div>

        <div class="bor10 p-all-30">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger m-b-20"></div>

                <div class="row">
                    <div class="col-md-8 m-b-20">
                        <label asp-for="ProductName" class="form-label">Product name</label>
                        <input asp-for="ProductName" class="form-control" placeholder="e.g. Rolex Submariner" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 m-b-20">
                        <label asp-for="ProductPrice" class="form-label">Price</label>
                        <input asp-for="ProductPrice" type="number" min="0" step="0.01" class="form-control" />
                        <span asp-validation-for="ProductPrice" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 m-b-20">
                        <label asp-for="ProductBrandId" class="form-label">Brand</label>
                        <select asp-for="ProductBrandId" id="brandSelect" class="form-control">
                            <option value="">Select a brand</option>
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.ProductBrandId">@brand.BrandName</option>
                            }
                        </select>
                        <span asp-validation-for="ProductBrandId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 m-b-20">
                        <label asp-for="ProductModelId" class="form-label">Model</label>
                        <select asp-for="ProductModelId" id="modelSelect" class="form-control">
                            <option value="">Select a brand first</option>
                            @foreach (var productModel in models)
                            {
                                <option value="@productModel.ProductModelId" data-brand-id="@productModel.ProductBrandId">@productModel.ModelName</option>
                            }
                        </select>
                        <span asp-validation-for="ProductModelId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 m-b-20">
                        <label for="subCategoryId" class="form-label">Subcategory</label>
                        <select id="subCategoryId" name="subCategoryId" class="form-control">
                            <option value="">Select a subcategory</option>
                            @foreach (var subCategory in subCategories)
                            {
                                if (selectedSubCategoryId == subCategory.SubCategoryId)
                                {
                                    <option value="@subCategory.SubCategoryId" selected>@subCategory.SubCategoryName</option>
                                }
                                else
                                {
                                    <option value="@subCategory.SubCategoryId">@subCategory.SubCategoryName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 m-b-20">
                        <label asp-for="ProductQuantity" class="form-label">Stock quantity</label>
                        <input asp-for="ProductQuantity" type="number" min="0" class="form-control" />
                        <span asp-validation-for="ProductQuantity" class="text-danger"></span>
                    </div>

                    <div class="col-md-8 m-b-20">
                        <label class="form-label fw-bold">Product Images</label>
                        
                        <!-- الحاوية التي ستستقبل حقول الرفع الديناميكية -->
                        <div id="image-inputs-container">
                            <div class="input-group m-b-10">
                                <input type="file" name="imageFiles" accept="image/*" class="form-control" />
                                <button type="button" class="btn btn-outline-danger remove-image-input" style="display:none;"><i class="fa fa-trash"></i></button>
                            </div>
                        </div>

                        <!-- زر إضافة حقل جديد -->
                        <button type="button" id="add-image-input-btn" class="btn btn-sm btn-outline-secondary mt-1">
                            <i class="fa fa-plus m-r-4"></i> Add Another Image
                        </button>
                        <small class="form-text text-muted d-block mt-1">You can add multiple image fields.</small>
                    </div>
                </div>

                <div class="m-b-25">
                    <label asp-for="ProductDescription" class="form-label">Description</label>
                    <textarea asp-for="ProductDescription" class="form-control" rows="5" placeholder="Describe the product."></textarea>
                    <span asp-validation-for="ProductDescription" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                        <i class="fa fa-save m-r-6"></i> Save product
                    </button>
                    <a asp-action="Index" class="flex-c-m stext-101 size-101 bor1 hov-btn1 btn-outline-gold cl2 p-lr-15">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // كود الفلترة للـ Brand و Model
            var brandSelect = document.getElementById('brandSelect');
            var modelSelect = document.getElementById('modelSelect');
            var modelOptions = Array.prototype.slice.call(modelSelect.querySelectorAll('option[data-brand-id]'));

            function filterModels() {
                var brandId = brandSelect.value;
                var previouslySelected = modelSelect.value;
                var hasMatch = false;

                modelOptions.forEach(function (option) {
                    var matches = option.getAttribute('data-brand-id') === brandId;
                    option.hidden = !matches;
                    option.disabled = !matches;

                    if (matches && option.value === previouslySelected) {
                        hasMatch = true;
                    }
                });

                if (!hasMatch) {
                    modelSelect.value = '';
                }
            }

            if (brandSelect && modelSelect) {
                brandSelect.addEventListener('change', filterModels);
                filterModels();
            }

            // كود إضافة حقول رفع الصور ديناميكياً
            var container = document.getElementById('image-inputs-container');
            var addBtn = document.getElementById('add-image-input-btn');

            if (addBtn && container) {
                addBtn.addEventListener('click', function () {
                    var div = document.createElement('div');
                    div.className = 'input-group m-b-10';
                    div.innerHTML = `
                        <input type="file" name="imageFiles" accept="image/*" class="form-control" />
                        <button type="button" class="btn btn-outline-danger remove-image-input"><i class="fa fa-trash"></i></button>
                    `;
                    container.appendChild(div);
                    updateRemoveButtons();
                });

                container.addEventListener('click', function (e) {
                    if (e.target.closest('.remove-image-input')) {
                        e.target.closest('.input-group').remove();
                        updateRemoveButtons();
                    }
                });

                function updateRemoveButtons() {
                    var groups = container.querySelectorAll('.input-group');
                    groups.forEach(function (group) {
                        var removeBtn = group.querySelector('.remove-image-input');
                        if (groups.length > 1) {
                            removeBtn.style.display = 'block';
                        } else {
                            removeBtn.style.display = 'none';
                        }
                    });
                }
            }
        })();
    </script>
}