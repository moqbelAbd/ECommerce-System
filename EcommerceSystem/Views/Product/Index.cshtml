@model IEnumerable<EcommerceSystem.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<!-- Title Banner -->
<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('/images/bg-01.jpg');">
    <h2 class="ltext-105 cl0 txt-center" style="font-weight: 600; letter-spacing: 2px; color: #222;">
        PRODUCT CATEGORIES
    </h2>
</section>

<div class="container py-5">

    <!-- Admin Actions Header -->
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-between align-items-center mb-5 p-3 bg-light rounded shadow-sm">
            <div>
                <h4 class="fw-bold mb-1" style="color: #1a1d20;">Admin Control Panel</h4>
                <p class="text-muted mb-0" style="font-size: 14px;">Manage store categories, subcategories, and structure.</p>
            </div>
            <a asp-action="Create" class="btn btn-dark px-4 py-2" style="border-radius: 20px;">
                <i class="fa fa-plus m-r-6"></i> Add Category
            </a>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="alert alert-info d-inline-block px-5 py-3">
                No categories found at the moment.
            </div>
        </div>
    }
    else
    {
        <div class="row isotope-grid">
            @foreach (var category in Model)
            {
                var cardData = new
                {
                    ImageUrl = category.CategoryImagePath,
                    Title = category.CategoryName,
                    Subtitle = $"Subcategories: {category.SubCategories?.Count ?? 0}",
                    DetailsUrl = Url.Action("Details", "Category", new { id = category.CategoryId }),
                    ButtonText = "View Category",
                    ShowAdminActions = User.IsInRole("Admin"),
                    EditUrl = Url.Action("Edit", "Category", new { id = category.CategoryId }),
                    DeleteUrl = Url.Action("Delete", "Category", new { id = category.CategoryId })
                };

                <partial name="_CardPartial" model="cardData" />
            }
        </div>
    }
</div>