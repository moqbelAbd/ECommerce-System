@model IEnumerable<EcommerceSystem.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<!-- Title Banner -->
<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('/images/bg-01.jpg');">
    <h2 class="ltext-105 cl0 txt-center" style="font-weight: 600; letter-spacing: 2px; color: #222;">
        PRODUCT CATEGORIES
    </h2>
</section>

<div class="container py-5">

    <!-- Admin Actions Header -->
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-between align-items-center mb-5 p-3 bg-light rounded shadow-sm">
            <div>
                <h4 class="fw-bold mb-1" style="color: #1a1d20;">Admin Control Panel</h4>
                <p class="text-muted mb-0" style="font-size: 14px;">Manage store categories, subcategories, and structure.</p>
            </div>
            <a asp-action="Create" class="btn btn-dark px-4 py-2" style="border-radius: 20px;">
                <i class="fa fa-plus m-r-6"></i> Add Category
            </a>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="alert alert-info d-inline-block px-5 py-3">
                No categories found at the moment.
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var category in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-4 p-b-35">
                    <!-- أضفنا كلاس category-card للتحكم بتأثير الـ Hover -->
                    <div class="card h-100 shadow-sm border-0 category-card" style="border-radius: 12px; overflow: hidden; background: #fff; transition: all 0.3s ease;">

                        <!-- Category Image with Hover Button -->
                        <div style="height: 250px; overflow: hidden; position: relative; background: #f8f9fa;">
                            <img src="@category.CategoryImagePath"
                                 alt="@category.CategoryName"
                                 style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;">

                            <!-- زر View Products يظهر عند الـ Hover -->
                            <a asp-action="Details"
                               asp-route-id="@category.CategoryId"
                               class="flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04 category-btn"
                               style="position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); opacity: 0; visibility: hidden; transition: all 0.3s ease; border-radius: 20px; text-decoration: none; font-weight: 500; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
                                View Products
                            </a>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column justify-content-between p-4 bg-white">
                            <div>
                                <h4 class="fw-bold mb-2" style="font-size: 20px; color: #111;">
                                    @category.CategoryName
                                </h4>
                                <p class="text-muted mb-0" style="font-size: 13px;">
                                    <i class="fa fa-tags m-r-5 text-secondary"></i> Subcategories:
                                    <span class="badge bg-secondary">@(category.SubCategories?.Count ?? 0)</span>
                                </p>
                            </div>

                            <!-- أزرار الإدارة للأدمن فقط تبقى ظاهرة ومرتبة -->
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top mt-3">
                                    <a asp-action="Edit"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-outline-warning btn-sm" title="Edit" style="border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-outline-danger btn-sm" title="Delete" style="border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .category-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }

        .category-card:hover img {
            transform: scale(1.05);
        }
        /* إظهار زر View Products عند تمرير الماوس على صورة البطاقة */
        .category-card:hover .category-btn {
            opacity: 1 !important;
            visibility: visible !important;
            bottom: 25px !important;
        }
</style>