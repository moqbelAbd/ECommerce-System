@using EcommerceSystem.Models
@model Product

@{
    ViewData["Title"] = "Edit Product";

    var brands = ViewBag.Brands as List<ProductBrand> ?? new List<ProductBrand>();
    var models = ViewBag.Models as List<ProductModel> ?? new List<ProductModel>();
    var subCategories = ViewBag.SubCategories as List<SubCategory> ?? new List<SubCategory>();
    var selectedSubCategoryIds = ViewBag.SelectedSubCategoryIds as List<Guid> ?? new List<Guid>();
    var existingImages = Model.ProductImages?.ToList() ?? new List<ProductImage>();
}

<div class="bg0 p-t-80 p-b-100">
    <div class="container" style="max-width: 900px;">
        <div class="flex-sb-m flex-w p-b-35">
            <div>
                <h1 class="ltext-103 cl5">Edit Product</h1>
                <p class="stext-102 cl6 p-t-5">Update catalog information, stock, and images.</p>
            </div>

            <a asp-action="Details" asp-route-id="@Model.ProductId" class="flex-c-m stext-101 size-101 bor1 hov-btn1 btn-outline-gold cl2 p-lr-15 m-tb-10">
                <i class="fa fa-eye m-r-6"></i> View details
            </a>
        </div>

        <div class="bor10 p-all-30">
            <form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data">
                <input asp-for="ProductId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger m-b-20"></div>

                <div class="row">
                    <div class="col-md-8 m-b-20">
                        <label asp-for="ProductName" class="form-label">Product name</label>
                        <input asp-for="ProductName" class="form-control" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 m-b-20">
                        <label asp-for="ProductPrice" class="form-label">Price</label>
                        <input asp-for="ProductPrice" type="number" min="0" step="0.01" class="form-control" />
                        <span asp-validation-for="ProductPrice" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 m-b-20">
                        <label asp-for="ProductBrandId" class="form-label">Brand</label>
                        <select asp-for="ProductBrandId" id="brandSelect" class="form-control">
                            <option value="">Select a brand</option>
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.ProductBrandId">@brand.BrandName</option>
                            }
                        </select>
                        <span asp-validation-for="ProductBrandId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 m-b-20">
                        <label asp-for="ProductModelId" class="form-label">Model</label>
                        <select asp-for="ProductModelId" id="modelSelect" class="form-control">
                            <option value="">Select a model</option>
                            @foreach (var productModel in models)
                            {
                                <option value="@productModel.ProductModelId" data-brand-id="@productModel.ProductBrandId">@productModel.ModelName</option>
                            }
                        </select>
                        <span asp-validation-for="ProductModelId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 m-b-20">
                        <label class="form-label">Subcategories (Max 3)</label>
                        <div class="subcategories-container" style="max-height: 120px; overflow-y: auto; border: 1px solid #e6e6e6; padding: 10px; border-radius: 6px; background-color: #fff;">
                            @foreach (var subCategory in subCategories)
                            {
                                var isChecked = selectedSubCategoryIds.Contains(subCategory.SubCategoryId);
                                <div class="form-check m-b-5" style="padding-left: 25px;">
                                    <input class="form-check-input subcategory-checkbox"
                                           type="checkbox"
                                           name="subCategoryIds"
                                           value="@subCategory.SubCategoryId"
                                           id="sub_@subCategory.SubCategoryId"
                                    @(isChecked ? "checked" : "")>
                                    <label class="form-check-label stext-111 cl6" for="sub_@subCategory.SubCategoryId" style="cursor: pointer;">
                                        @subCategory.SubCategoryName
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-4 m-b-20">
                        <label asp-for="ProductQuantity" class="form-label">Stock quantity</label>
                        <input asp-for="ProductQuantity" type="number" min="0" class="form-control" />
                        <span asp-validation-for="ProductQuantity" class="text-danger"></span>
                    </div>

                    <div class="col-12 m-b-20">
                        <label class="form-label fw-bold">Current Images</label>
                        @if (existingImages.Any())
                        {
                            <div class="d-flex flex-wrap gap-3 m-b-15">
                                @foreach (var image in existingImages)
                                {
                                    <div class="card p-2 text-center" style="width: 110px;">
                                        <div style="width: 90px; height: 90px; overflow: hidden; border-radius: 6px; margin: 0 auto;">
                                            <img src="@Url.Content(image.ProductImagePath)" alt="Product Image" style="width: 100%; height: 100%; object-fit: cover;" />
                                        </div>
                                        <div class="form-check mt-2 text-start" style="font-size: 13px; padding-left: 1.5rem;">
                                            <input class="form-check-input" type="checkbox" name="deleteImageIds" value="@image.ProductImageId" id="del_@image.ProductImageId">
                                            <label class="form-check-label text-danger" for="del_@image.ProductImageId">
                                                Delete
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No images uploaded for this product yet.</p>
                        }

                        <label class="form-label m-t-10 fw-bold">Add More Images</label>
                        
                        <!-- الحاوية التي ستستقبل حقول الرفع الديناميكية الجديدة -->
                        <div id="image-inputs-container">
                            <div class="input-group m-b-10">
                                <input type="file" name="imageFiles" accept="image/*" class="form-control" />
                                <button type="button" class="btn btn-outline-danger remove-image-input" style="display:none;"><i class="fa fa-trash"></i></button>
                            </div>
                        </div>

                        <!-- زر إضافة حقل رفع إضافي -->
                        <button type="button" id="add-image-input-btn" class="btn btn-sm btn-outline-secondary mt-1">
                            <i class="fa fa-plus m-r-4"></i> Add Another Image
                        </button>
                        <small class="form-text text-muted d-block mt-1">Selected new images will be added alongside the kept images.</small>
                    </div>
                </div>

                <div class="m-b-25">
                    <label asp-for="ProductDescription" class="form-label">Description</label>
                    <textarea asp-for="ProductDescription" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="ProductDescription" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                        <i class="fa fa-save m-r-6"></i> Save changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.ProductId" class="flex-c-m stext-101 size-101 bor1 hov-btn1 btn-outline-gold cl2 p-lr-15">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // كود الفلترة للـ Brand و Model
            var brandSelect = document.getElementById('brandSelect');
            var modelSelect = document.getElementById('modelSelect');
            var modelOptions = Array.prototype.slice.call(modelSelect.querySelectorAll('option[data-brand-id]'));

            function filterModels() {
                var brandId = brandSelect.value;
                var previouslySelected = modelSelect.value;
                var hasMatch = false;

                modelOptions.forEach(function (option) {
                    var matches = option.getAttribute('data-brand-id') === brandId;
                    option.hidden = !matches;
                    option.disabled = !matches;

                    if (matches && option.value === previouslySelected) {
                        hasMatch = true;
                    }
                });

                if (!hasMatch) {
                    modelSelect.value = '';
                }
            }

            if (brandSelect && modelSelect) {
                brandSelect.addEventListener('change', filterModels);
                filterModels();
            }


            var container = document.getElementById('image-inputs-container');
            var addBtn = document.getElementById('add-image-input-btn');

            if (addBtn && container) {
                addBtn.addEventListener('click', function () {
                    var div = document.createElement('div');
                    div.className = 'input-group m-b-10';
                    div.innerHTML = `
                        <input type="file" name="imageFiles" accept="image/*" class="form-control" />
                        <button type="button" class="btn btn-outline-danger remove-image-input"><i class="fa fa-trash"></i></button>
                    `;
                    container.appendChild(div);
                    updateRemoveButtons();
                });

                container.addEventListener('click', function (e) {
                    if (e.target.closest('.remove-image-input')) {
                        e.target.closest('.input-group').remove();
                        updateRemoveButtons();
                    }
                });

                function updateRemoveButtons() {
                    var groups = container.querySelectorAll('.input-group');
                    groups.forEach(function (group) {
                        var removeBtn = group.querySelector('.remove-image-input');
                        if (groups.length > 1) {
                            removeBtn.style.display = 'block';
                        } else {
                            removeBtn.style.display = 'none';
                        }
                    });
                }
            }
        })();

        // Limit Subcategory Checkboxes to Max 3
        var limit = 3;
        var subCheckboxes = document.querySelectorAll('.subcategory-checkbox');

        subCheckboxes.forEach(function(checkbox) {
            checkbox.addEventListener('change', function() {
                var checkedCount = document.querySelectorAll('.subcategory-checkbox:checked').length;
                if (checkedCount > limit) {
                    this.checked = false; // Uncheck the box immediately
                    if (typeof showToast === 'function') {
                        showToast("You can only select a maximum of 3 subcategories.", "warning");
                    } else {
                        alert("You can only select a maximum of 3 subcategories.");
                    }
                }
            });
        });
    </script>
}