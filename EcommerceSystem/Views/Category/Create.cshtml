@model EcommerceSystem.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<!-- Title Banner -->
<section class="bg-img1 txt-center p-lr-15 p-tb-75" style="background-image: url('/images/bg-01.jpg');">
    <h2 class="ltext-105 cl0 txt-center" style="font-weight: 600; letter-spacing: 2px; color: #222;">
        ADD NEW CATEGORY
    </h2>
</section>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">

                <div class="card-header bg-dark text-white p-4 text-center">
                    <h4 class="mb-1 fw-bold" style="letter-spacing: 1px; color: #c9aa6f;">Category Details</h4>
                    <p class="text-muted mb-0" style="font-size: 13px; color: #adb5bd !important;">Upload an image and fill in the category name.</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <!-- إضافة enctype لدعم رفع الملفات -->
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Category Name Field -->
                        <div class="mb-4">
                            <label asp-for="CategoryName" class="form-label fw-semibold" style="color: #333;">
                                Category Name <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 8px 0 0 8px;">
                                    <i class="fa fa-tag text-secondary"></i>
                                </span>
                                <input asp-for="CategoryName" class="form-control border-start-0 bg-light" placeholder="e.g. Luxury Timepieces" style="border-radius: 0 8px 8px 0; padding: 12px;" />
                            </div>
                            <span asp-validation-for="CategoryName" class="text-danger d-block mt-1" style="font-size: 13px;"></span>
                        </div>

                        <!-- Upload Image Field -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold" style="color: #333;">
                                Category Image <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 8px 0 0 8px;">
                                    <i class="fa fa-image text-secondary"></i>
                                </span>
                                <!-- استخدام type="file" لاختيار الصورة من الجهاز -->
                                <input type="file" name="categoryImage" class="form-control border-start-0 bg-light" accept="image/*" style="border-radius: 0 8px 8px 0; padding: 10px;" required />
                            </div>
                            <small class="form-text text-muted">Choose an image file (jpg, png, jpeg).</small>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 20px; font-weight: 500;">
                                <i class="fa fa-arrow-left m-r-5"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-dark px-5 py-2" style="border-radius: 20px; font-weight: 500; background-color: #1a1d20;">
                                <i class="fa fa-check m-r-5 text-warning"></i> Create Category
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}