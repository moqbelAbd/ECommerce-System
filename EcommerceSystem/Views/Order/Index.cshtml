@using EcommerceSystem.Models
@using EcommerceSystem.Models.ViewModels
@model IEnumerable<AdminOrderListItem>

@{
    ViewData["Title"] = "Manage Orders";

    var orderStatuses = ViewBag.OrderStatuses as List<OrderStatus>
                         ?? new List<OrderStatus>();

    var paymentStatuses = ViewBag.PaymentStatuses as List<PaymentStatus>
                         ?? new List<PaymentStatus>();

    string? search = ViewBag.Search;
    int? selectedOrderStatusId = ViewBag.SelectedOrderStatusId;
    int? selectedPaymentStatusId = ViewBag.SelectedPaymentStatusId;
}

<div class="bg0 p-t-80 p-b-100">

    <div class="container">

        <!-- Page Header -->
        <div class="flex-sb-m flex-w p-b-35">

            <div>
                <h1 class="ltext-103 cl5">
                    Manage Orders
                </h1>

                <p class="stext-102 cl6 p-t-5">
                    Review orders, update statuses and inspect order items.
                </p>
            </div>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }


        <!-- Filters -->
        <div class="bor10 p-all-20 m-b-40">

            <form asp-controller="Order"
                  asp-action="Index"
                  method="get">

                <div class="row">

                    <!-- Search -->
                    <div class="col-md-5 m-b-15">

                        <label class="stext-102 cl3">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Customer name, phone, or location..." />

                    </div>


                    <!-- Order Status -->
                    <div class="col-md-3 m-b-15">

                        <label class="stext-102 cl3">
                            Order Status
                        </label>

                        <select name="orderStatusId"
                                class="form-control">

                            <option value="">
                                All Statuses
                            </option>

                            @foreach (var status in orderStatuses)
                            {
                                <option value="@status.OrderStatusId"
                                        selected="@(selectedOrderStatusId == status.OrderStatusId)">

                                    @status.OrderStatusName

                                </option>
                            }

                        </select>

                    </div>


                    <!-- Payment Status -->
                    <div class="col-md-4 m-b-15">

                        <label class="stext-102 cl3">
                            Payment Status
                        </label>

                        <select name="paymentStatusId"
                                class="form-control">

                            <option value="">
                                All Payment Statuses
                            </option>

                            @foreach (var status in paymentStatuses)
                            {
                                <option value="@status.PaymentStatusId"
                                        selected="@(selectedPaymentStatusId == status.PaymentStatusId)">

                                    @status.PaymentStatusName

                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="d-flex m-t-10">

                    <button type="submit"
                            class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-20 m-r-10 trans-04">

                        <i class="fa fa-filter m-r-8"></i>

                        Apply Filters

                    </button>


                    <a asp-controller="Order"
                       asp-action="Index"
                       class="flex-c-m stext-101 size-101 bor1 hov-btn1 btn-outline-gold cl2 p-lr-20">

                        Clear

                    </a>

                </div>

            </form>

        </div>


        <!-- Order Count -->
        <div class="flex-sb-m flex-w p-b-20">

            <div>

                <span class="stext-102 cl6">

                    Showing

                    <strong>
                        @Model.Count()
                    </strong>

                    order(s)

                </span>

            </div>

        </div>


        <!-- Orders Table -->
        @if (!Model.Any())
        {
            <div class="bor10 p-all-40 text-center">

                <i class="fa fa-box-open fa-2x m-b-15"></i>

                <h4 class="mtext-102 cl2">
                    No orders found
                </h4>

            </div>
        }
        else
        {
            <div class="wrap-table-shopping-cart">

                <table class="table-shopping-cart">

                    <thead>

                        <tr class="table_head">

                            <th class="column-1">Order ID</th>
                            <th class="column-2">Customer</th>
                            <th class="column-3">Phone</th>
                            <th class="column-4">Location</th>
                            <th class="column-5">Total Price</th>
                            <th class="column-6">Payment Status</th>
                            <th class="column-7">Order Status</th>
                            <th class="column-8">Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var order in Model)
                        {
                            <tr class="table_row">

                                <!-- Order ID -->
                                <td class="column-1">
                                    <span style="font-size: 12px; font-weight: 400; color: #999;">
                                        @order.OrderId
                                    </span>
                                </td>


                                <!-- Customer -->
                                <td class="column-2">
                                    @order.CustomerName
                                </td>


                                <!-- Phone -->
                                <td class="column-3">
                                    @(order.CustomerPhoneNumber ?? "-")
                                </td>


                                <!-- Location -->
                                <td class="column-4">
                                    @(order.Location ?? "-")
                                </td>


                                <!-- Total Price -->
                                <td class="column-5">
                                    <strong>
                                        @order.TotalPrice.ToString("C")
                                    </strong>
                                </td>


                                <!-- Payment Status -->
                                <td class="column-6">

                                    <form asp-controller="Order"
                                          asp-action="UpdatePaymentStatus"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="orderId"
                                               value="@order.OrderId" />

                                        <select name="paymentStatusId"
                                                class="form-control form-select form-select-sm"
                                                style="font-size: 12px; padding: 4px 28px 4px 10px; min-width: 120px;"
                                                onchange="this.form.submit()">

                                            @foreach (var status in paymentStatuses)
                                            {
                                                <option value="@status.PaymentStatusId"
                                                        selected="@(status.PaymentStatusId == order.PaymentStatusId)">

                                                    @status.PaymentStatusName

                                                </option>
                                            }

                                        </select>

                                    </form>

                                </td>


                                <!-- Order Status -->
                                <td class="column-7">

                                    <form asp-controller="Order"
                                          asp-action="UpdateStatus"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="orderId"
                                               value="@order.OrderId" />

                                        <select name="orderStatusId"
                                                class="form-control form-select form-select-sm"
                                                style="font-size: 12px; padding: 4px 28px 4px 10px; min-width: 120px;"
                                                onchange="this.form.submit()">

                                            @foreach (var status in orderStatuses)
                                            {
                                                <option value="@status.OrderStatusId"
                                                        selected="@(status.OrderStatusId == order.OrderStatusId)">

                                                    @status.OrderStatusName

                                                </option>
                                            }

                                        </select>

                                    </form>

                                </td>


                                <!-- Action -->
                                <td class="column-8">

                                    <a asp-controller="Order"
                                       asp-action="Preview"
                                       asp-route-id="@order.OrderId"
                                       class="btn btn-sm btn-outline-secondary">

                                        <i class="fa fa-eye"></i>
                                        Preview

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>
