@model EcommerceSystem.Models.Order

@{
    ViewData["Title"] = "Order Preview";

    var phoneNumber = Model.Customer?.CustomerPhoneNumbers
        .Where(p => !p.IsDeleted)
        .Select(p => p.PhoneNumber)
        .FirstOrDefault();
}

<div class="bg0 p-t-60 p-b-100">
    <div class="container">

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-3" style="border-bottom: 2px solid #1a1d20;">
            <div>
                <h2 class="fw-bold mb-1" style="color: #1a1d20; letter-spacing: 1px;">
                    Order #@Model.OrderId
                </h2>
                <p class="text-muted mb-0" style="font-size: 14px;">
                    Placed on @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                </p>
            </div>

            <div class="mt-3 mt-md-0">
                <a asp-controller="Order"
                   asp-action="Index"
                   class="btn px-4 py-2 fw-semibold shadow-sm"
                   style="border-radius: 20px; border: 1px solid #c9aa6f; background-color: #1a1d20; color: #c9aa6f; transition: all 0.3s;"
                   onmouseover="this.style.backgroundColor='#c9aa6f'; this.style.color='#1a1d20';"
                   onmouseout="this.style.backgroundColor='#1a1d20'; this.style.color='#c9aa6f';">
                    <i class="fa fa-arrow-left m-r-5"></i> Back to Orders
                </a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Order Info Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4 p-md-5 h-100" style="border-radius: 16px; background-color: #fcfcfc; border: 1px solid #1a1d20 !important;">
                    <h4 class="fw-bold pb-3 mb-3 border-bottom" style="color: #1a1d20; font-size: 18px;">
                        <i class="fa fa-shopping-bag m-r-8" style="color: #c9aa6f;"></i> Order Information
                    </h4>

                    <dl class="row mb-0" style="font-size: 14px;">
                        <dt class="col-sm-5 text-secondary py-2">Order Status</dt>
                        <dd class="col-sm-7 py-2">
                            <span class="badge px-3 py-2" style="font-size: 12px; border-radius: 6px; background-color: rgba(201,170,111,0.2); color: #1a1d20; border: 1px solid #c9aa6f;">
                                @(Model.OrderStatus?.OrderStatusName ?? "-")
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-secondary py-2">Payment Status</dt>
                        <dd class="col-sm-7 py-2">
                            <span class="badge px-3 py-2" style="font-size: 12px; border-radius: 6px; background-color: #1a1d20; color: #fff;">
                                @(Model.PaymentStatus?.PaymentStatusName ?? "-")
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-secondary py-2">Payment Type</dt>
                        <dd class="col-sm-7 py-2 fw-semibold text-dark">@(Model.PaymentType?.PaymentTypeName ?? "-")</dd>

                        <dt class="col-sm-5 text-secondary py-2">Location</dt>
                        <dd class="col-sm-7 py-2 text-dark">@(Model.Location ?? "-")</dd>

                        <dt class="col-sm-5 text-secondary py-2">Total Price</dt>
                        <dd class="col-sm-7 py-2">
                            <strong style="color: #c9aa6f; font-size: 18px;">@Model.TotalPrice.ToString("C")</strong>
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Customer Info Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4 p-md-5 h-100" style="border-radius: 16px; background-color: #fcfcfc; border: 1px solid #1a1d20 !important;">
                    <h4 class="fw-bold pb-3 mb-3 border-bottom" style="color: #1a1d20; font-size: 18px;">
                        <i class="fa fa-user m-r-8" style="color: #c9aa6f;"></i> Customer Information
                    </h4>

                    <dl class="row mb-0" style="font-size: 14px;">
                        <dt class="col-sm-5 text-secondary py-2">Name</dt>
                        <dd class="col-sm-7 py-2 fw-bold text-dark">
                            @(Model.Customer == null
                                ? "-"
                                : $"{Model.Customer.FirstName} {Model.Customer.LastName}")
                        </dd>

                        <dt class="col-sm-5 text-secondary py-2">Phone Number</dt>
                        <dd class="col-sm-7 py-2 text-dark">@(phoneNumber ?? "-")</dd>

                        <dt class="col-sm-5 text-secondary py-2">Location</dt>
                        <dd class="col-sm-7 py-2 text-dark">@(Model.Customer?.Location ?? "-")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Order Items Section -->
        <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: 16px; border: 1px solid #1a1d20 !important;">
            <h4 class="fw-bold pb-3 mb-3 border-bottom" style="color: #1a1d20; font-size: 18px;">
                <i class="fa fa-list m-r-8" style="color: #c9aa6f;"></i> Order Items
            </h4>

            @if (!Model.OrderItems.Any())
            {
                <div class="text-center py-5">
                    <i class="fa fa-box-open fa-3x mb-3" style="color: #c9aa6f;"></i>
                    <h5 class="fw-bold text-dark">No items in this order</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead style="background-color: #1a1d20; color: #fff;">
                            <tr>
                                <th class="py-3 px-3 text-white">Product</th>
                                <th class="py-3 px-3 text-center text-white">Quantity</th>
                                <th class="py-3 px-3 text-end text-white">Item Total Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr style="border-bottom: 1px solid #eaeaea;">
                                    <td class="py-3 px-3 fw-semibold text-dark">
                                        @(item.Product?.ProductName ?? "Deleted product")
                                    </td>
                                    <td class="py-3 px-3 text-center text-secondary">
                                        @item.ItemQuantity
                                    </td>
                                    <td class="py-3 px-3 text-end fw-bold" style="color: #1a1d20;">
                                        @item.ItemTotalPrice.ToString("C")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>