@model IEnumerable<EcommerceSystem.Models.Product>
@{
    ViewData["Title"] = "Home Page  ";

    var featuredCategories = ViewBag.FeaturedCategories as List<Category> ?? new List<Category>();
    var featuredProducts = ViewBag.FeaturedProducts as List<Product> ?? new List<Product>();

    var userWishlistIds = ViewBag.UserWishlistIds as List<Guid> ?? new List<Guid>();
}

<!-- Slider -->
<section class="section-slide">
    <div class="wrap-slick1">
        <div class="slick1">
            <div class="item-slick1" style="background-image: url('@Url.Content("~/images/slide-01.jpg")');">
                <div class="container h-full">
                    <div class="flex-col-l-m h-full p-t-150 p-b-30 respon5">
                        <div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
                            <span class="ltext-101 cl2 respon2">
                                Luxury Collection 2026
                            </span>
                        </div>

                        <div class="layer-slick1 animated visible-false" data-appear="fadeInUp" data-delay="800">
                            <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
                                TIMELESS ELEGANCE
                            </h2>
                        </div>

                        <div class="layer-slick1 animated visible-false" data-appear="zoomIn" data-delay="1600">
                            <a asp-controller="Home" asp-action="Shop" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                                Shop Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="item-slick1" style="background-image: url('@Url.Content("~/images/slide-02.jpg")');">
                <div class="container h-full">
                    <div class="flex-col-l-m h-full p-t-150 p-b-30 respon5">
                        <div class="layer-slick1 animated visible-false" data-appear="rollIn" data-delay="0">
                            <span class="ltext-101 cl2 respon2">
                                Classic & Casual
                            </span>
                        </div>

                        <div class="layer-slick1 animated visible-false" data-appear="lightSpeedIn" data-delay="800">
                            <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
                                WATCHES & STRAPS
                            </h2>
                        </div>

                        <div class="layer-slick1 animated visible-false" data-appear="slideInUp" data-delay="1600">
                            <a asp-controller="Home" asp-action="Shop" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                                Shop Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="item-slick1" style="background-image: url('@Url.Content("~/images/slide-03.jpg")');">
                <div class="container h-full">
                    <div class="flex-col-l-m h-full p-t-150 p-b-30 respon5">
                        <div class="layer-slick1 animated visible-false" data-appear="rotateInDownLeft" data-delay="0">
                            <span class="ltext-101 cl2 respon2">
                                Premium Accessories
                            </span>
                        </div>

                        <div class="layer-slick1 animated visible-false" data-appear="rotateInUpRight" data-delay="800">
                            <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
                                NEW ARRIVALS
                            </h2>
                        </div>

                        <div class="layer-slick1 animated visible-false" data-appear="rotateIn" data-delay="1600">
                            <a asp-controller="Home" asp-action="Shop" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                                Shop Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Banner -->
@if (featuredCategories.Any())
{
    <div class="sec-banner bg0 p-t-80 p-b-50">
        <div class="container">
            <div class="row">
                @foreach (var category in featuredCategories)
                {
                    <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                        <div class="block1 wrap-pic-w">
                            <img src="@Url.Content(category.CategoryImagePath)" alt="@category.CategoryName">
                            <a asp-controller="Home" asp-action="Shop" asp-route-categoryId="@category.CategoryId"
                               class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                                <div class="block1-txt-child1 flex-col-l">
                                    <span class="block1-name ltext-102 trans-04 p-b-8">
                                        @category.CategoryName
                                    </span>
                                </div>
                                <div class="block1-txt-child2 p-b-4 trans-05">
                                    <div class="block1-link stext-101 cl0 trans-09">
                                        Shop Now
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Product Overview -->
<section class="bg0 p-t-23 p-b-80">
    <div class="container">
        <div class="p-b-30">
            <h3 class="ltext-103 cl5">
                Product Overview
            </h3>
        </div>

        <div class="flex-w flex-sb-m p-b-52">
            <div class="flex-w flex-l-m filter-tope-group m-tb-10">
                <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 how-active1" data-filter="*">
                    All Products
                </button>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <div class="alert alert-info d-inline-block px-5 py-3">
                    No products found.
                </div>
            </div>
        }
        else
        {
            <div class="row isotope-grid">
                @foreach (var product in Model)
                {
                    var imagePath = product.ProductImages
                        .FirstOrDefault()
                        ?.ProductImagePath
                        ?? "~/images/product-01.jpg";

                    var cardData = new
                    {
                        ProductId = product.ProductId,
                        IsInWishlist = userWishlistIds.Contains(product.ProductId),
                        ImageUrl = Url.Content(imagePath),
                        Title = product.ProductName,
                        Subtitle = product.ProductPrice.ToString("C"),
                        DetailsUrl = Url.Action("Details", "Product", new { id = product.ProductId }),
                        ButtonText = "Quick View",
                        ShowAdminActions = User.IsInRole("Admin"),
                        EditUrl = Url.Action("Edit", "Product", new { id = product.ProductId }),
                        DeleteUrl = Url.Action("Delete", "Product", new { id = product.ProductId })
                    };

                    <partial name="_ProductCardPartial" model="cardData" />
                }
            </div>
        }

        <div class="flex-c-m flex-w w-full p-t-45">
            <a asp-controller="Home" asp-action="Shop" class="flex-c-m stext-101 cl5 size-103 bg2 bor1 hov-btn1 p-lr-15 trans-04">
                View All Products
            </a>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="sec-testimonials bg6 p-t-80 p-b-80">
    <div class="container">
        <div class="p-b-42 d-flex justify-content-between align-items-center flex-wrap">
            <h3 class="ltext-105 cl5 respon1 m-0">
                What Our Customers Say
            </h3>

            @{
                var hasSubmittedTestimonial = ViewBag.HasSubmittedTestimonial != null && (bool)ViewBag.HasSubmittedTestimonial;
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
            {
                @if (!hasSubmittedTestimonial)
                {
                    <button type="button" id="openTestimonialModalBtn" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                        <i class="fa fa-pencil m-r-8"></i> Add Review
                    </button>
                }
                else
                {
                    <span class="text-muted" style="font-size: 13px;">You have already shared your experience.</span>
                }
            }
        </div>

        @{
            var testimonials = ViewBag.Testimonials as List<EcommerceSystem.Models.Testimonial> ?? new List<EcommerceSystem.Models.Testimonial>();
        }

        @if (!testimonials.Any())
        {
            <div class="text-center py-4 text-muted">
                <p>No customer reviews yet. Be the first to share your experience!</p>
            </div>
        }
        else
        {
            <div class="wrap-slick2 position-relative">
                <div class="testimonial-slick">
                    @foreach (var t in testimonials)
                    {
                        <div class="item-slick2 p-lr-15">
                            <div class="p-all-30 bg0 bor10 hov-shadow1 trans-04" style="min-height: 200px; display: flex; flex-direction: column; justify-content: space-between; border-radius: 12px;">
                                <p class="stext-114 cl6 p-b-26">
                                    "@t.CustomerTestimonial"
                                </p>
                                <span class="mtext-107 cl2 font-weight-bold">
                                    - @(t.Customer != null ? $"{t.Customer.FirstName} {t.Customer.LastName}" : "Valued Customer")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Testimonial Modal (Popup) -->
<div class="modal fade" id="testimonialModal" tabindex="-1" aria-labelledby="testimonialModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="margin-top: 80px; max-width: 650px;">
        <div class="modal-content bor10 p-all-30 bg-white shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h4 class="modal-title mtext-105 cl2 fw-bold" id="testimonialModalLabel">Share Your Experience</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Home" asp-action="AddTestimonial" method="post">
                <div class="modal-body p-t-20 p-b-20">
                    <div class="mb-3">
                        <label class="stext-102 cl3 mb-2 d-block fw-bold" style="font-size: 15px;">Your Review</label>
                        <textarea name="customerTestimonial" class="form-control" rows="5" placeholder="Write your experience with our store..." required maxlength="250" style="font-size: 14px; padding: 12px;"></textarea>
                        <small class="text-muted">Maximum 250 characters. Will be reviewed before publishing.</small>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary px-4 py-2" data-bs-dismiss="modal" style="font-size: 14px;">Cancel</button>
                    <button type="submit" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-20 trans-04" style="width: auto; height: 42px; font-size: 14px;">Submit Review</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- FAQ -->
<section class="sec-faq bg0 p-t-80 p-b-90">
    <div class="container">
        <div class="p-b-45">
            <h3 class="ltext-105 cl5 txt-center respon1">
                Frequently Asked Questions
            </h3>
            <p class="stext-113 cl6 txt-center p-t-10">
                Swipe through to find answers about our luxury collections and services.
            </p>
        </div>

        <div class="wrap-slick2 position-relative">
            <div class="faq-slick">
                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg-light bor10 hov-shadow1 trans-04" style="height: 220px; display: flex; flex-direction: column; justify-content: center; border-radius: 12px; border: 1px solid #eaeaea;">
                        <h5 class="stext-110 cl2 p-b-12" style="font-weight: 600;">
                            <i class="zmdi zmdi-help-outline m-r-6" style="color: #717fe0;"></i> Are all watches authentic?
                        </h5>
                        <p class="stext-111 cl6">
                            Yes, all our timepieces and gift sets (such as Timberland and Bigotti) are 100% original with official warranties.
                        </p>
                    </div>
                </div>

                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg-light bor10 hov-shadow1 trans-04" style="height: 220px; display: flex; flex-direction: column; justify-content: center; border-radius: 12px; border: 1px solid #eaeaea;">
                        <h5 class="stext-110 cl2 p-b-12" style="font-weight: 600;">
                            <i class="zmdi zmdi-help-outline m-r-6" style="color: #717fe0;"></i> What are delivery options?
                        </h5>
                        <p class="stext-111 cl6">
                            We provide fast shipping across Amman and all governorates in Jordan within 1 to 3 business days.
                        </p>
                    </div>
                </div>

                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg-light bor10 hov-shadow1 trans-04" style="height: 220px; display: flex; flex-direction: column; justify-content: center; border-radius: 12px; border: 1px solid #eaeaea;">
                        <h5 class="stext-110 cl2 p-b-12" style="font-weight: 600;">
                            <i class="zmdi zmdi-help-outline m-r-6" style="color: #717fe0;"></i> Can I return a product?
                        </h5>
                        <p class="stext-111 cl6">
                            Yes, we offer a hassle-free 14-day return and exchange policy for unused items in original packaging.
                        </p>
                    </div>
                </div>

                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg-light bor10 hov-shadow1 trans-04" style="height: 220px; display: flex; flex-direction: column; justify-content: center; border-radius: 12px; border: 1px solid #eaeaea;">
                        <h5 class="stext-110 cl2 p-b-12" style="font-weight: 600;">
                            <i class="zmdi zmdi-help-outline m-r-6" style="color: #717fe0;"></i> Do you offer gift wrapping?
                        </h5>
                        <p class="stext-111 cl6">
                            Absolutely! Every order can be packed in our signature luxury gift boxes with custom greeting cards.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const slickPrevButton = '<button type="button" class="slick-prev" style="z-index: 2;"><i class="fa fa-angle-left" style="font-size: 22px;"></i></button>';
            const slickNextButton = '<button type="button" class="slick-next" style="z-index: 2;"><i class="fa fa-angle-right" style="font-size: 22px;"></i></button>';

            // Testimonial Slider
            if ($('.testimonial-slick').length > 0) {
                $('.testimonial-slick').slick({
                    slidesToShow: 3,
                    slidesToScroll: 1,
                    infinite: true,
                    autoplay: true,
                    autoplaySpeed: 4000,
                    arrows: true,
                    dots: false,
                    prevArrow: slickPrevButton,
                    nextArrow: slickNextButton,
                    responsive: [
                        { breakpoint: 1200, settings: { slidesToShow: 3 } },
                        { breakpoint: 992, settings: { slidesToShow: 2 } },
                        { breakpoint: 576, settings: { slidesToShow: 1 } }
                    ]
                });
            }

            // FAQ Slider
            if ($('.faq-slick').length > 0) {
                $('.faq-slick').slick({
                    slidesToShow: 3,
                    slidesToScroll: 1,
                    infinite: true,
                    autoplay: true,
                    autoplaySpeed: 4000,
                    arrows: true,
                    dots: false,
                    prevArrow: slickPrevButton,
                    nextArrow: slickNextButton,
                    responsive: [
                        { breakpoint: 1200, settings: { slidesToShow: 3 } },
                        { breakpoint: 992, settings: { slidesToShow: 2 } },
                        { breakpoint: 576, settings: { slidesToShow: 1 } }
                    ]
                });
            }

            // Testimonial Modal Logic
            const openBtn = document.getElementById("openTestimonialModalBtn");
            const modal = document.getElementById("testimonialModal");

            if (openBtn && modal) {
                const closeButtons = modal.querySelectorAll('[data-bs-dismiss="modal"], .btn-close');

                openBtn.addEventListener("click", function() {
                    modal.style.display = "block";
                    modal.classList.add("show");
                    modal.style.backgroundColor = "rgba(0,0,0,0.5)";
                    document.body.classList.add("modal-open");
                });

                closeButtons.forEach(btn => {
                    btn.addEventListener("click", function() {
                        modal.style.display = "none";
                        modal.classList.remove("show");
                        document.body.classList.remove("modal-open");
                        const backdrop = document.querySelector(".modal-backdrop");
                        if (backdrop) backdrop.remove();
                    });
                });

                window.addEventListener("click", function(event) {
                    if (event.target === modal) {
                        modal.style.display = "none";
                        modal.classList.remove("show");
                        document.body.classList.remove("modal-open");
                        const backdrop = document.querySelector(".modal-backdrop");
                        if (backdrop) backdrop.remove();
                    }
                });
            }
        });
    </script>
}

<style>
    /* Styling for Slick Slider Custom Side Arrows */
    .wrap-slick2 {
        position: relative;
    }

    .slick-prev, .slick-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.9) !important;
        border: 1px solid #ddd !important;
        border-radius: 50% !important;
        width: 45px !important;
        height: 45px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        cursor: pointer;
        z-index: 10;
    }

    .slick-prev {
        left: -25px !important;
    }

    .slick-next {
        right: -25px !important;
    }

        .slick-prev:hover, .slick-next:hover {
            background: #c5a059 !important;
            color: #fff !important;
            border-color: #c5a059 !important;
        }

            .slick-prev:hover i, .slick-next:hover i {
                color: #fff !important;
            }
</style>