                        <div class="block1-txt-child1 flex-col-l">
                            <span class="block1-name ltext-102 trans-04 p-b-8">
                                Fine Necklaces
                            </span>
                        </div>
                        <div class="block1-txt-child2 p-b-4 trans-05">
                            <div class="block1-link stext-101 cl0 trans-09">
                                Shop Now
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                <div class="block1 wrap-pic-w">
                    <img src="~/images/banner-02.jpg" alt="IMG-BANNER">
                    <a href="#" class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                        <div class="block1-txt-child1 flex-col-l">
                            <span class="block1-name ltext-102 trans-04 p-b-8">
                                Luxury Timepieces
                            </span>
                        </div>
                        <div class="block1-txt-child2 p-b-4 trans-05">
                            <div class="block1-link stext-101 cl0 trans-09">
                                Shop Now
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                <div class="block1 wrap-pic-w">
                    <img src="~/images/banner-03.jpg" alt="IMG-BANNER">
                    <a href="#" class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                        <div class="block1-txt-child1 flex-col-l">
                            <span class="block1-name ltext-102 trans-04 p-b-8">
                                Elegant Rings
                            </span>
                        </div>
                        <div class="block1-txt-child2 p-b-4 trans-05">
                            <div class="block1-link stext-101 cl0 trans-09">
                                Shop Now
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Product Overview -->
<section class="bg0 p-t-23 p-b-80">
    <div class="container">
        <div class="p-b-10">
            <h3 class="ltext-103 cl5">
                Product Overview
            </h3>
        </div>

        <div class="flex-w flex-sb-m p-b-52">
            <div class="flex-w flex-l-m filter-tope-group m-tb-10">
                <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 how-active1" data-filter="*">
                    All Products
                </button>
                <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".watches">
                    Watches
                </button>
                <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".straps">
                    Necklaces
                </button>
                <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".accessories">
                    Rings
                </button>
            </div>
        </div>

        <!-- Product Grid (Using _CardPartial) -->
        <div class="row isotope-grid">
            @{
                // قائمة مؤقتة للمنتجات (يمكن استبدالها بـ Model قادم من الكنترولر لاحقاً)
                var sampleProducts = new[]
                {
                    new { ImageUrl = Url.Content("~/images/Men/Watch10/timberland-watch.png"), Title = "Timberland Classic Men Watch", Subtitle = "$145.00", DetailsUrl = "#" },
                    new { ImageUrl = Url.Content("~/images/Men/GiftBox1/bigotti-giftset.png"), Title = "Bigotti Milano Men Gift Set", Subtitle = "$189.50", DetailsUrl = "#" },
                    new { ImageUrl = Url.Content("~/images/Women/Watch5/watch5-daniel-klein.png"), Title = "Daniel Klein Elegant Women Watch", Subtitle = "$95.00", DetailsUrl = "#" }
                };
            }

            @foreach (var prod in sampleProducts)
            {
                var cardData = new
                {
                    ImageUrl = prod.ImageUrl,
                    Title = prod.Title,
                    Subtitle = prod.Subtitle,
                    DetailsUrl = prod.DetailsUrl,
                    ButtonText = "Quick View",
                    ShowAdminActions = User.IsInRole("Admin"),
                    EditUrl = "#",
                    DeleteUrl = "#"
                };

                <partial name="_CardPartial" model="cardData" />
            }
        </div>

        <div class="flex-c-m flex-w w-full p-t-45">
            <a href="#" class="flex-c-m stext-101 cl5 size-103 bg2 bor1 hov-btn1 p-lr-15 trans-04">
                Load More
            </a>
        </div>
    </div>
</section>

<!-- Testimonials Section (Converted to Slick Slider) -->
<section class="sec-testimonials bg6 p-t-80 p-b-80">
    <div class="container">
        <div class="p-b-42">
            <h3 class="ltext-105 cl5 txt-center respon1">
                What Our Customers Say
            </h3>
        </div>

        <div class="wrap-slick2">
            <div class="slick2">
                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg0 bor10 hov-shadow1 trans-04" style="min-height: 200px; display: flex; flex-direction: column; justify-content: space-between; border-radius: 12px;">
                        <p class="stext-114 cl6 p-b-26">
                            "The quality of the watches is exceptional! Fast delivery and amazing customer service here in Amman."
                        </p>
                        <span class="mtext-107 cl2 font-weight-bold">
                            - Ahmad Omar
                        </span>
                    </div>
                </div>

                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg0 bor10 hov-shadow1 trans-04" style="min-height: 200px; display: flex; flex-direction: column; justify-content: space-between; border-radius: 12px;">
                        <p class="stext-114 cl6 p-b-26">
                            "I ordered a classic leather watch and it exceeded my expectations. Beautiful packaging too!"
                        </p>
                        <span class="mtext-107 cl2 font-weight-bold">
                            - Sarah Naser
                        </span>
                    </div>
                </div>

                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg0 bor10 hov-shadow1 trans-04" style="min-height: 200px; display: flex; flex-direction: column; justify-content: space-between; border-radius: 12px;">
                        <p class="stext-114 cl6 p-b-26">
                            "Best watch store online! Great variety of modern designs and very reasonable prices."
                        </p>
                        <span class="mtext-107 cl2 font-weight-bold">
                            - Tariq Ziad
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="sec-faq bg0 p-t-80 p-b-90">
    <div class="container">
        <div class="p-b-45">
            <h3 class="ltext-105 cl5 txt-center respon1">
                Frequently Asked Questions
            </h3>
            <p class="stext-113 cl6 txt-center p-t-10">
                Swipe through to find answers about our luxury collections and services.
            </p>
        </div>

        <div class="wrap-slick2">
            <div class="slick2">
                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg-light bor10 hov-shadow1 trans-04" style="height: 220px; display: flex; flex-direction: column; justify-content: center; border-radius: 12px; border: 1px solid #eaeaea;">
                        <h5 class="stext-110 cl2 p-b-12" style="font-weight: 600;">
                            <i class="zmdi zmdi-help-outline m-r-6" style="color: #717fe0;"></i> Are all watches authentic?
                        </h5>
                        <p class="stext-111 cl6">
                            Yes, all our timepieces and gift sets (such as Timberland and Bigotti) are 100% original with official warranties.
                        </p>
                    </div>
                </div>

                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg-light bor10 hov-shadow1 trans-04" style="height: 220px; display: flex; flex-direction: column; justify-content: center; border-radius: 12px; border: 1px solid #eaeaea;">
                        <h5 class="stext-110 cl2 p-b-12" style="font-weight: 600;">
                            <i class="zmdi zmdi-help-outline m-r-6" style="color: #717fe0;"></i> What are delivery options?
                        </h5>
                        <p class="stext-111 cl6">
                            We provide fast shipping across Amman and all governorates in Jordan within 1 to 3 business days.
                        </p>
                    </div>
                </div>

                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg-light bor10 hov-shadow1 trans-04" style="height: 220px; display: flex; flex-direction: column; justify-content: center; border-radius: 12px; border: 1px solid #eaeaea;">
                        <h5 class="stext-110 cl2 p-b-12" style="font-weight: 600;">
                            <i class="zmdi zmdi-help-outline m-r-6" style="color: #717fe0;"></i> Can I return a product?
                        </h5>
                        <p class="stext-111 cl6">
                            Yes, we offer a hassle-free 14-day return and exchange policy for unused items in original packaging.
                        </p>
                    </div>
                </div>

                <div class="item-slick2 p-lr-15">
                    <div class="p-all-30 bg-light bor10 hov-shadow1 trans-04" style="height: 220px; display: flex; flex-direction: column; justify-content: center; border-radius: 12px; border: 1px solid #eaeaea;">
                        <h5 class="stext-110 cl2 p-b-12" style="font-weight: 600;">
                            <i class="zmdi zmdi-help-outline m-r-6" style="color: #717fe0;"></i> Do you offer gift wrapping?
                        </h5>
                        <p class="stext-111 cl6">
                            Absolutely! Every order can be packed in our signature luxury gift boxes with custom greeting cards.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if ($('.slick2').length > 0) {
                $('.slick2').slick({
                    slidesToShow: 3,
                    slidesToScroll: 1,
                    infinite: true,
                    autoplay: true,
                    autoplaySpeed: 4000,
                    arrows: true,
                    dots: false,
                    responsive: [
                        {
                            breakpoint: 1200,
                            settings: { slidesToShow: 3 }
                        },
                        {
                            breakpoint: 992,
                            settings: { slidesToShow: 2 }
                        },
                        {
                            breakpoint: 576,
                            settings: { slidesToShow: 1 }
                        }
                    ]
                });
            }
        });
    </script>
}