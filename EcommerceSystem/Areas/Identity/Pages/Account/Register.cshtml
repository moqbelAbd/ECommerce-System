@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container p-t-100 p-b-80">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="bor10 p-lr-40 p-tb-30 m-l-r-auto bg0">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <h4 class="mtext-105 cl2 txt-center p-b-30">
                        Create a New Account
                    </h4>

                    <div asp-validation-summary="ModelOnly" class="text-danger p-b-15" role="alert"></div>

                    <!-- Email Input -->
                    <div class="bor8 m-b-20 how-pos4-parent">
                        <input asp-for="Input.Email" class="stext-111 cl2 plh3 size-116 p-l-25 p-r-30" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="bor8 m-b-20">
                        <input asp-for="Input.Password" class="stext-111 cl2 plh3 size-116 p-l-25 p-r-30" autocomplete="new-password" aria-required="true" placeholder="Password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <!-- Confirm Password Input -->
                    <div class="bor8 m-b-30">
                        <input asp-for="Input.ConfirmPassword" class="stext-111 cl2 plh3 size-116 p-l-25 p-r-30" autocomplete="new-password" aria-required="true" placeholder="Confirm password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <!-- Submit Button -->
                    <button id="registerSubmit" type="submit" class="flex-c-m stext-101 cl0 size-121 bg3 bor1 hov-btn3 p-lr-15 trans-04 pointer w-full">
                        Register
                    </button>

                    <!-- Back to Login Link -->
                    <div class="p-t-25 txt-center">
                        <p>
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="stext-102 cl7 hov-cl1">
                                Already have an account? <b>Log in</b>
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}