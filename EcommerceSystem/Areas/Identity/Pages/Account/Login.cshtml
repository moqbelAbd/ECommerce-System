@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container p-t-100 p-b-80">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="bor10 p-lr-40 p-tb-30 m-l-r-auto bg0">
                <form id="account" method="post">
                    <h4 class="mtext-105 cl2 txt-center p-b-30">
                        Log In To Your Account
                    </h4>

                    <div asp-validation-summary="ModelOnly" class="text-danger p-b-15" role="alert"></div>

                    <!-- Email Input -->
                    <div class="bor8 m-b-20 how-pos4-parent">
                        <input asp-for="Input.Email" class="stext-111 cl2 plh3 size-116 p-l-25 p-r-30" autocomplete="username" aria-required="true" placeholder="Email address" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="bor8 m-b-20">
                        <input asp-for="Input.Password" class="stext-111 cl2 plh3 size-116 p-l-25 p-r-30" autocomplete="current-password" aria-required="true" placeholder="Password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <!-- Remember Me Checkbox -->
                    <div class="flex-w flex-sb-m p-b-30">
                        <div class="contact100-form-checkbox">
                            <input class="input-checkbox1" id="ckb1" type="checkbox" asp-for="Input.RememberMe">
                            <label class="label-checkbox1 stext-102 cl6" for="ckb1">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                        <div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="stext-102 cl7 hov-cl1">
                                Forgot password?
                            </a>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button id="login-submit" type="submit" class="flex-c-m stext-101 cl0 size-121 bg3 bor1 hov-btn3 p-lr-15 trans-04 pointer w-full">
                        Log in
                    </button>

                    <!-- Additional Links -->
                    <div class="p-t-25 txt-center">
                        <p class="p-b-10">
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="stext-102 cl7 hov-cl1">
                                Don't have an account? <b>Register as a new user</b>
                            </a>
                        </p>
                        <p>
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="stext-102 cl7 hov-cl1">
                                Resend email confirmation
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}